
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="花销记账本 · 智能分析版：三级分类记账、固定/弹性拆分、健康评分与三档理财方案">
<title>花销记账本 · 智能分析版</title>
&lt;b&gt;&lt;script src=&quot;https:&#x2F;&#x2F;cdn.sheetjs.com&#x2F;xlsx-0.20.1&#x2F;package&#x2F;dist&#x2F;xlsx.full.min.js&quot;&gt;&lt;&#x2F;script&gt;&lt;&#x2F;b&gt;
&lt;b&gt;&lt;script src=&quot;https:&#x2F;&#x2F;cdn.jsdelivr.net&#x2F;npm&#x2F;chart.js@4.4.0&#x2F;dist&#x2F;chart.umd.min.js&quot;&gt;&lt;&#x2F;script&gt;&lt;&#x2F;b&gt;
<style>
/* ============================================================
   1. 设计令牌（Design Tokens）
   ============================================================ */
:root{
  --bg:#f3f5fa; --bg-2:#eaeef7; --card:#ffffff; --card-2:#fafbfe; --card-3:#f1f4fb;
  --text:#0f172a; --text-2:#566578; --text-3:#8a97ab;
  --border:#e3e8f2; --border-2:#eef1f8; --line:#f0f3f9;
  --primary:#2f6bff; --primary-2:#1c50d8; --primary-soft:#e9f0ff;
  --ok:#0f9d76; --ok-soft:#e4f7f0;
  --warn:#dd8800; --warn-soft:#fff4e0;
  --danger:#e04a4f; --danger-soft:#ffeded;
  --info:#7357ff; --info-soft:#f0edff;
  --expense:#e07a00; --income:#0f9d76; --balance:#2f6bff;
  --shadow:0 1px 2px rgba(15,23,42,.04), 0 10px 26px -12px rgba(15,23,42,.14);
  --shadow-sm:0 1px 2px rgba(15,23,42,.05);
  --radius:16px; --radius-sm:10px; --radius-xs:8px; --pill:999px;
  --ff:system-ui,-apple-system,'Segoe UI',Roboto,'PingFang SC','Microsoft YaHei',sans-serif;
  --t:.18s cubic-bezier(.4,0,.2,1);
  --left:336px;
}
[data-theme="dark"]{
  --bg:#0c1119; --bg-2:#111825; --card:#151c28; --card-2:#1a2231; --card-3:#1e2735;
  --text:#e8edf6; --text-2:#9aa8bd; --text-3:#6d7c92;
  --border:#243044; --border-2:#1e2838; --line:#1e2838;
  --primary:#5b8cff; --primary-2:#7ba3ff; --primary-soft:#1b2740;
  --ok:#2ec79a; --ok-soft:#12291f;
  --warn:#f0aa3a; --warn-soft:#2a2113;
  --danger:#ff6b6f; --danger-soft:#2c1618;
  --info:#9b86ff; --info-soft:#221d3a;
  --expense:#f2a33c; --income:#2ec79a; --balance:#5b8cff;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 26px -14px rgba(0,0,0,.6);
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--ff); background:var(--bg); color:var(--text);
  line-height:1.55; -webkit-font-smoothing:antialiased; overflow-x:hidden;
  transition:background var(--t), color var(--t);
}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer;border:none;background:none}
ul{list-style:none}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:9px}
::-webkit-scrollbar-thumb:hover{background:var(--text-3)}
::-webkit-scrollbar-track{background:transparent}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:6px}

/* ============================================================
   2. 通用组件
   ============================================================ */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm)}
.pad{padding:18px 20px}
.sec-title{display:flex;align-items:center;gap:8px;font-weight:700;font-size:.95rem;margin-bottom:14px}
.sec-title .hint{font-weight:400;font-size:.76rem;color:var(--text-3);margin-left:auto}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:8px 16px;border-radius:var(--pill);font-size:.82rem;font-weight:600;
  border:1px solid transparent;background:var(--card-3);color:var(--text);
  transition:var(--t);white-space:nowrap;
}
.btn:hover{filter:brightness(.97);transform:translateY(-1px)}
.btn:active{transform:translateY(0)}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-2);filter:none}
.btn-outline{border-color:var(--border);background:var(--card);color:var(--text)}
.btn-outline:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-soft)}
.btn-ghost{background:transparent;color:var(--text-2)}
.btn-ghost:hover{background:var(--card-3);color:var(--text)}
.btn-danger{background:var(--danger-soft);color:var(--danger)}
.btn-danger:hover{background:var(--danger);color:#fff}
.btn-sm{padding:5px 12px;font-size:.76rem}
.btn-xs{padding:3px 9px;font-size:.72rem;border-radius:var(--radius-xs)}
.btn-block{width:100%}
.icon-btn{
  display:inline-flex;align-items:center;justify-content:center;
  width:32px;height:32px;border-radius:50%;color:var(--text-2);transition:var(--t);
}
.icon-btn:hover{background:var(--card-3);color:var(--primary)}
.icon-btn svg{width:17px;height:17px}
.chip{
  display:inline-flex;align-items:center;gap:4px;padding:2px 9px;border-radius:var(--pill);
  font-size:.71rem;font-weight:700;letter-spacing:.02em;
}
.chip-ok{background:var(--ok-soft);color:var(--ok)}
.chip-warn{background:var(--warn-soft);color:var(--warn)}
.chip-danger{background:var(--danger-soft);color:var(--danger)}
.chip-info{background:var(--info-soft);color:var(--info)}
.chip-plain{background:var(--card-3);color:var(--text-2)}
.muted{color:var(--text-2)} .muted-3{color:var(--text-3)}
.num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}
.neg{color:var(--danger)} .pos{color:var(--ok)}
.empty{padding:34px 16px;text-align:center;color:var(--text-3);font-size:.86rem}
.empty svg{width:38px;height:38px;opacity:.35;margin-bottom:8px}
.divider{height:1px;background:var(--line);margin:14px 0}
.field{margin-bottom:12px}
.field label{display:block;font-size:.76rem;font-weight:700;color:var(--text-2);margin-bottom:5px}
.field input,.field select,.field textarea{
  width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);
  background:var(--card-2);color:var(--text);font-size:.88rem;transition:var(--t);
}
.field input:focus,.field select:focus,.field textarea:focus{
  border-color:var(--primary);background:var(--card);box-shadow:0 0 0 3px var(--primary-soft);outline:none;
}
.field textarea{resize:vertical;min-height:64px;line-height:1.5}
.money-input{position:relative}
.money-input .sym{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-weight:800;color:var(--text-3);pointer-events:none}
.money-input input{padding-left:32px;font-size:1.25rem;font-weight:800;letter-spacing:-.01em}
.row{display:flex;gap:8px;align-items:center}
.grid{display:grid;gap:12px}

/* ============================================================
   3. 布局骨架
   ============================================================ */
.app-header{
  position:sticky;top:0;z-index:60;display:flex;align-items:center;gap:14px;
  padding:10px 20px;background:color-mix(in srgb,var(--card) 86%,transparent);
  backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--border);
}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;font-size:1.03rem;letter-spacing:-.01em}
.brand .mark{
  width:30px;height:30px;border-radius:9px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--primary),var(--info));color:#fff;font-size:.9rem;
}
.header-tools{margin-left:auto;display:flex;align-items:center;gap:6px}
.period-pill{
  display:flex;align-items:center;gap:2px;padding:3px;border-radius:var(--pill);
  background:var(--card-3);border:1px solid var(--border);
}
.period-pill span{min-width:104px;text-align:center;font-weight:700;font-size:.82rem}
.main{display:flex;gap:16px;padding:16px 20px 40px;max-width:1560px;margin:0 auto;align-items:flex-start}
.side{flex:0 0 var(--left);display:flex;flex-direction:column;gap:14px;position:sticky;top:74px}
.content{flex:1;min-width:0;display:flex;flex-direction:column;gap:14px}
@media(max-width:1080px){
  .main{flex-direction:column;padding:12px 12px 96px}
  .side{position:static;flex:1 1 auto;width:100%}
  .app-header{padding:8px 12px;flex-wrap:wrap}
}
.tabs{display:flex;gap:4px;padding:4px;border-radius:var(--pill);background:var(--card);border:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{
  padding:7px 16px;border-radius:var(--pill);font-size:.82rem;font-weight:600;
  color:var(--text-2);transition:var(--t);white-space:nowrap;
}
.tab:hover{color:var(--text);background:var(--card-3)}
.tab.active{background:var(--primary);color:#fff;box-shadow:0 4px 12px -4px var(--primary)}
.view{display:none;flex-direction:column;gap:14px}
.view.active{display:flex}
.pane{display:none;flex-direction:column;gap:14px}
.pane.active{display:flex}

/* ============================================================
   4. KPI / 摘要
   ============================================================ */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(146px,1fr));gap:12px}
.kpi{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:14px 16px;box-shadow:var(--shadow-sm);position:relative;overflow:hidden;transition:var(--t);
}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.kpi .k-top{display:flex;align-items:center;gap:7px;font-size:.75rem;font-weight:700;color:var(--text-2);margin-bottom:8px}
.kpi .k-top .dot{width:7px;height:7px;border-radius:50%;background:var(--primary)}
.kpi .k-val{font-size:1.42rem;font-weight:800;letter-spacing:-.02em;line-height:1.15}
.kpi .k-sub{font-size:.72rem;color:var(--text-3);margin-top:5px;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.kpi.accent-exp .k-val{color:var(--expense)} .kpi.accent-exp .dot{background:var(--expense)}
.kpi.accent-bal .k-val{color:var(--balance)} .kpi.accent-bal .dot{background:var(--balance)}
.kpi.accent-ok .k-val{color:var(--ok)} .kpi.accent-ok .dot{background:var(--ok)}
.kpi.accent-bad .k-val{color:var(--danger)} .kpi.accent-bad .dot{background:var(--danger)}

/* ============================================================
   5. 明细列表
   ============================================================ */
.detail-wrap{max-height:min(58vh,620px);overflow-y:auto;padding-right:4px}
.day-head{
  position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;
  padding:8px 12px;margin:8px 0 4px;border-radius:var(--radius-sm);
  background:var(--card-3);font-size:.8rem;font-weight:800;
}
.day-head .dh-r{color:var(--expense)}
.rec{
  display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;
  padding:9px 10px;border-bottom:1px solid var(--line);font-size:.85rem;border-radius:var(--radius-xs);
  transition:background var(--t);
}
.rec:hover{background:var(--card-2)}
.rec .r-main{min-width:0}
.rec .r-cat{font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rec .r-note{font-size:.74rem;color:var(--text-3);display:block;margin-top:1px}
.rec .r-amt{font-weight:800;color:var(--expense)}
.rec .r-amt.is-transfer{color:var(--info)}
.rec .r-amt.is-income{color:var(--income)}
.rec .r-del{opacity:0;transition:var(--t)}
.rec:hover .r-del{opacity:1}
.tagx{font-size:.68rem;padding:1px 6px;border-radius:var(--pill);background:var(--info-soft);color:var(--info);font-weight:700;margin-left:6px}

/* ============================================================
   6. 图表
   ============================================================ */
.chart-box{position:relative;height:300px}
.chart-box canvas{width:100%!important;height:100%!important}
.seg{display:flex;gap:4px;padding:3px;border-radius:var(--pill);background:var(--card-3)}
.seg button{padding:5px 13px;border-radius:var(--pill);font-size:.76rem;font-weight:600;color:var(--text-2);transition:var(--t)}
.seg button.active{background:var(--card);color:var(--primary);box-shadow:var(--shadow-sm)}

/* ============================================================
   7. 分析模块
   ============================================================ */
.score-card{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.gauge{position:relative;width:132px;height:132px;flex:0 0 auto}
.gauge svg{transform:rotate(-90deg)}
.gauge .g-val{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
}
.gauge .g-num{font-size:2rem;font-weight:800;letter-spacing:-.03em;line-height:1}
.gauge .g-lbl{font-size:.7rem;color:var(--text-3);font-weight:700;margin-top:3px}
.dims{flex:1;min-width:250px;display:grid;gap:9px}
.dim{display:grid;grid-template-columns:84px 1fr 40px;gap:10px;align-items:center;font-size:.78rem}
.dim .d-name{color:var(--text-2);font-weight:600}
.dim .d-track{height:7px;border-radius:var(--pill);background:var(--card-3);overflow:hidden}
.dim .d-fill{height:100%;border-radius:var(--pill);transition:width .5s cubic-bezier(.4,0,.2,1)}
.dim .d-val{text-align:right;font-weight:800;font-variant-numeric:tabular-nums}
.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:10px}
.metric{
  background:var(--card-2);border:1px solid var(--border-2);border-radius:var(--radius-sm);padding:11px 13px;
}
.metric .m-lbl{font-size:.73rem;color:var(--text-2);font-weight:600;display:flex;align-items:center;gap:5px}
.metric .m-val{font-size:1.12rem;font-weight:800;margin-top:3px;letter-spacing:-.01em}
.metric .m-note{font-size:.7rem;color:var(--text-3);margin-top:2px}
.findings{display:grid;gap:10px}
.finding{
  display:grid;grid-template-columns:34px 1fr;gap:12px;padding:13px 15px;border-radius:var(--radius-sm);
  background:var(--card-2);border:1px solid var(--border-2);border-left:3px solid var(--text-3);
}
.finding.sev-critical{border-left-color:var(--danger);background:var(--danger-soft)}
.finding.sev-warn{border-left-color:var(--warn);background:var(--warn-soft)}
.finding.sev-info{border-left-color:var(--primary);background:var(--primary-soft)}
.finding.sev-good{border-left-color:var(--ok);background:var(--ok-soft)}
.finding.pinned{box-shadow:0 0 0 2px color-mix(in srgb,var(--warn) 30%,transparent)}
.nudge{display:flex;gap:11px;align-items:flex-start;padding:11px 14px;border-radius:var(--radius-sm);
  margin-bottom:9px;border:1px solid var(--border-2);background:var(--card)}
.nudge .n-ico{font-size:1.05rem;line-height:1.35}
.nudge .n-body{flex:1;min-width:0;font-size:.8rem}
.nudge .n-body b{display:block;font-weight:800;margin-bottom:2px}
.nudge .n-body span{color:var(--text-2)}
.nudge.sev-warn{background:var(--warn-soft);border-color:color-mix(in srgb,var(--warn) 26%,transparent)}
.nudge.sev-critical{background:var(--danger-soft);border-color:color-mix(in srgb,var(--danger) 26%,transparent)}
details.rules summary{cursor:pointer;font-size:.82rem;color:var(--text-2);font-weight:600;list-style:none;padding:4px 0}
details.rules summary::-webkit-details-marker{display:none}
details.rules summary::before{content:'▸ ';color:var(--primary);font-weight:800}
details.rules[open] summary::before{content:'▾ '}
.rule-group{margin:14px 0}
.rule-g{font-size:.74rem;font-weight:800;color:var(--text-3);letter-spacing:.03em;margin-bottom:7px}
.rule-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:8px}
.rule-item{display:flex;align-items:center;gap:8px;justify-content:space-between;background:var(--card-2);
  border:1px solid var(--border-2);border-radius:var(--radius-xs);padding:6px 10px;font-size:.78rem}
.rule-item span{color:var(--text-2);flex:1;min-width:0}
.rule-item input{width:86px;padding:5px 8px;border:1px solid var(--border);border-radius:6px;
  background:var(--card);text-align:right;font-variant-numeric:tabular-nums;font-size:.82rem}
.finding .f-ico{font-size:1.05rem;text-align:center;line-height:1.4}
.finding .f-title{font-weight:800;font-size:.87rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.finding .f-body{font-size:.8rem;color:var(--text-2);margin-top:4px;line-height:1.6}
.finding .f-act{font-size:.78rem;margin-top:6px;padding-top:6px;border-top:1px dashed var(--border);color:var(--text)}
.finding .f-act b{color:var(--primary)}
.bar-list{display:grid;gap:9px}
.bar-row{display:grid;grid-template-columns:96px 1fr 108px;gap:10px;align-items:center;font-size:.8rem}
.bar-row .b-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-row .b-track{height:9px;border-radius:var(--pill);background:var(--card-3);overflow:hidden}
.bar-row .b-fill{height:100%;border-radius:var(--pill);transition:width .5s cubic-bezier(.4,0,.2,1)}
.bar-row .b-val{text-align:right;font-variant-numeric:tabular-nums;color:var(--text-2);font-size:.77rem}
.bar-row .b-val b{color:var(--text);font-weight:800}
.plan-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.plan-tab{
  padding:9px 17px;border-radius:var(--radius-sm);border:1px solid var(--border);
  background:var(--card-2);font-size:.83rem;font-weight:700;color:var(--text-2);transition:var(--t);text-align:left;
}
.plan-tab small{display:block;font-weight:500;font-size:.7rem;color:var(--text-3);margin-top:1px}
.plan-tab.active{border-color:var(--primary);background:var(--primary-soft);color:var(--primary)}
.plan-tab.active small{color:var(--primary)}
.plan-body{display:none} .plan-body.active{display:block}
table.tbl{width:100%;border-collapse:collapse;font-size:.81rem}
table.tbl th,table.tbl td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left}
table.tbl th{font-size:.72rem;color:var(--text-2);font-weight:700;background:var(--card-2);position:sticky;top:0}
table.tbl td.n,table.tbl th.n{text-align:right;font-variant-numeric:tabular-nums}
table.tbl tr:last-child td{border-bottom:none;font-weight:800}
table.tbl tfoot td{background:var(--card-2)}
.tbl-scroll{overflow:auto;max-height:420px;border:1px solid var(--border-2);border-radius:var(--radius-sm)}
.callout{
  padding:13px 16px;border-radius:var(--radius-sm);background:var(--primary-soft);
  border:1px solid color-mix(in srgb,var(--primary) 24%,transparent);font-size:.83rem;line-height:1.65;
}
.callout.warn{background:var(--warn-soft);border-color:color-mix(in srgb,var(--warn) 26%,transparent)}
.callout.danger{background:var(--danger-soft);border-color:color-mix(in srgb,var(--danger) 26%,transparent)}
.callout.ok{background:var(--ok-soft);border-color:color-mix(in srgb,var(--ok) 26%,transparent)}
.callout b{font-weight:800}
.calc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.calc{background:var(--card-2);border:1px solid var(--border-2);border-radius:var(--radius-sm);padding:14px}
.calc h4{font-size:.82rem;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.calc .out{margin-top:10px;padding-top:10px;border-top:1px dashed var(--border);font-size:.8rem;display:grid;gap:4px}
.calc .out .line{display:flex;justify-content:space-between;gap:8px}
.calc .out .line b{font-weight:800;font-variant-numeric:tabular-nums}

/* ============================================================
   8. 预算
   ============================================================ */
.bud-row{display:grid;grid-template-columns:1fr 118px;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}
.bud-row:last-child{border-bottom:none}
.bud-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:.83rem}
.bud-top b{font-weight:700}
.bud-track{height:8px;border-radius:var(--pill);background:var(--card-3);overflow:hidden;margin-top:7px;position:relative}
.bud-fill{height:100%;border-radius:var(--pill);transition:width .5s cubic-bezier(.4,0,.2,1)}
.bud-meta{display:flex;justify-content:space-between;font-size:.72rem;color:var(--text-3);margin-top:4px}

/* ============================================================
   9. 抽屉 / 弹窗 / 提示
   ============================================================ */
.overlay{position:fixed;inset:0;background:rgba(10,15,25,.42);backdrop-filter:blur(2px);z-index:150;opacity:0;visibility:hidden;transition:var(--t)}
.overlay.open{opacity:1;visibility:visible}
.drawer{
  position:fixed;top:0;right:0;width:min(330px,92vw);height:100%;background:var(--card);z-index:151;
  transform:translateX(101%);transition:transform .28s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(0,0,0,.16);
}
.drawer.open{transform:translateX(0)}
.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--border)}
.drawer-head h3{font-size:.98rem;font-weight:800}
.drawer-body{padding:14px 14px 30px;overflow-y:auto;flex:1}
.dr-group{font-size:.7rem;font-weight:800;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin:14px 6px 7px}
.dr-btn{
  display:flex;align-items:center;gap:11px;width:100%;padding:11px 13px;border-radius:var(--radius-sm);
  font-size:.86rem;font-weight:600;color:var(--text);background:var(--card-2);
  border:1px solid var(--border-2);margin-bottom:7px;text-align:left;transition:var(--t);
}
.dr-btn:hover{background:var(--primary-soft);border-color:var(--primary);color:var(--primary)}
.dr-btn svg{width:17px;height:17px;flex:0 0 auto;opacity:.8}
.dr-btn small{display:block;font-weight:400;font-size:.71rem;color:var(--text-3)}
.modal{
  position:fixed;z-index:200;inset:0;display:none;align-items:center;justify-content:center;padding:18px;
  background:rgba(10,15,25,.45);backdrop-filter:blur(3px);
}
.modal.open{display:flex}
.modal-card{
  background:var(--card);border-radius:var(--radius);width:100%;max-width:660px;max-height:86vh;
  display:flex;flex-direction:column;box-shadow:0 24px 60px -12px rgba(0,0,0,.4);animation:pop .2s ease;
}
.modal-card.narrow{max-width:420px}
.modal-card.wide{max-width:880px}
@keyframes pop{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}
.modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 20px;border-bottom:1px solid var(--border)}
.modal-head h3{font-size:1rem;font-weight:800}
.modal-body{padding:18px 20px;overflow-y:auto}
.modal-foot{padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:9px;justify-content:flex-end}
.toast-wrap{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);z-index:400;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{
  padding:10px 20px;border-radius:var(--pill);background:#111a2b;color:#fff;font-size:.83rem;font-weight:600;
  box-shadow:0 10px 30px -8px rgba(0,0,0,.5);animation:up .22s ease;white-space:nowrap;
}
[data-theme="dark"] .toast{background:#e8edf6;color:#0f172a}
.toast.out{opacity:0;transform:translateY(8px);transition:var(--t)}
@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.cat-node{display:flex;align-items:center;gap:6px;margin:4px 0;padding:5px 8px;background:var(--card-2);border-radius:var(--radius-xs);border:1px solid var(--border-2)}
.cat-node input{flex:1;min-width:0;padding:6px 9px;border:1px solid transparent;border-radius:var(--radius-xs);background:transparent;font-size:.83rem;font-weight:600}
.cat-node input:hover{border-color:var(--border)}
.cat-node input:focus{border-color:var(--primary);background:var(--card);outline:none}
.cat-node .acts{display:flex;gap:3px}
.cat-tree,.cat-tree ul{list-style:none}
.cat-tree ul{padding-left:18px;border-left:1px dashed var(--border);margin-left:8px}
.cat-tree li{margin:3px 0}
.mobile-bar{display:none}
@media(max-width:1080px){
  .mobile-bar{
    display:flex;position:fixed;bottom:0;left:0;right:0;z-index:70;background:var(--card);
    border-top:1px solid var(--border);padding:6px 4px calc(6px + env(safe-area-inset-bottom));
  }
  .mobile-bar button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;font-size:.68rem;font-weight:700;color:var(--text-3);border-radius:var(--radius-sm)}
  .mobile-bar button.active{color:var(--primary)}
  .mobile-bar svg{width:19px;height:19px}
}
@media print{
  .side,.app-header,.tabs,.mobile-bar,.drawer,.overlay{display:none!important}
  .main{display:block;padding:0}
  .card{box-shadow:none;break-inside:avoid}
}
</style>
</head>
<body>

<!-- ============================ 顶栏 ============================ -->
<header class="app-header">
  <div class="brand"><span class="mark">¥</span><span>花销记账本</span><span class="chip chip-plain">智能分析版</span></div>
  <div class="header-tools">
    <div class="period-pill" id="periodPill">
      <button class="icon-btn" data-action="nav-prev" title="上一期" aria-label="上一期">◀</button>
      <span id="periodLabel">—</span>
      <button class="icon-btn" data-action="nav-next" title="下一期" aria-label="下一期">▶</button>
    </div>
    <button class="btn btn-ghost btn-sm" data-action="nav-today">回到本月</button>
    <button class="icon-btn" data-action="toggle-theme" title="切换深色/浅色" aria-label="切换主题">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button class="btn btn-outline btn-sm" data-action="open-drawer">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      设置
    </button>
  </div>
</header>

<!-- ============================ 主体 ============================ -->
<div class="main">
  <!-- ---------- 左侧：录入 ---------- -->
  <aside class="side">
    <section class="card pad">
      <div class="sec-title">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        记录花销
      </div>
      <div class="field">
        <label for="expAmount">金额</label>
        <div class="money-input"><span class="sym">¥</span><input type="number" id="expAmount" placeholder="0.00" step="0.01" min="0.01" inputmode="decimal"></div>
      </div>
      <div class="field"><label for="expDate">日期</label><input type="date" id="expDate"></div>
      <div class="field"><label for="catL1">一级分类</label>
        <div class="row"><select id="catL1" style="flex:1"></select><button class="icon-btn" data-action="quick-cat" data-level="1" title="快速新增一级分类">＋</button></div>
      </div>
      <div class="field"><label for="catL2">二级分类</label>
        <div class="row"><select id="catL2" style="flex:1"></select><button class="icon-btn" data-action="quick-cat" data-level="2" title="快速新增二级分类">＋</button></div>
      </div>
      <div class="field"><label for="catL3">三级分类</label>
        <div class="row"><select id="catL3" style="flex:1"></select><button class="icon-btn" data-action="quick-cat" data-level="3" title="快速新增三级分类">＋</button></div>
      </div>
      <div class="field"><label for="expNote">备注</label><input type="text" id="expNote" placeholder="选填，例如：京东肉菜"></div>
      <button class="btn btn-primary btn-block" data-action="add-expense" style="padding:12px;border-radius:var(--pill)">添加支出</button>
    </section>

    <section class="card pad">
      <div class="sec-title">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--income)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="7" x2="12" y2="17"/><polyline points="8 13 12 17 16 13"/></svg>
        月度收入
      </div>
      <div class="field"><label for="incMonth">月份</label><input type="month" id="incMonth"></div>
      <div class="field">
        <label for="incAmount">本月到手收入</label>
        <div class="money-input"><span class="sym">¥</span><input type="number" id="incAmount" placeholder="0.00" step="0.01" min="0" inputmode="decimal"></div>
      </div>
      <div class="row">
        <button class="btn btn-primary btn-sm" style="flex:1" data-action="save-income">保存收入</button>
        <button class="btn btn-outline btn-sm" data-action="load-income">读取当月</button>
      </div>
      <div class="muted-3" style="font-size:.72rem;margin-top:9px;line-height:1.5">储蓄率、结余与所有分析口径都依赖收入记录，请按月补全。</div>
    </section>

    <section class="card pad">
      <div class="sec-title">最近 5 条支出</div>
      <ul id="recentList" class="detail-wrap" style="max-height:180px"></ul>
    </section>
  </aside>

  <!-- ---------- 右侧：内容 ---------- -->
  <main class="content">
    <div class="tabs" role="tablist">
      <button class="tab active" data-action="pane" data-pane="record" role="tab">概览</button>
      <button class="tab" data-action="pane" data-pane="detail" role="tab">明细</button>
      <button class="tab" data-action="pane" data-pane="analysis" role="tab">数据分析与建议</button>
      <button class="tab" data-action="pane" data-pane="budget" role="tab">预算管控</button>
    </div>

    <!-- ========== 概览 ========== -->
    <section class="pane active" id="pane-record">
      <div id="dataNudge"></div>
      <div class="kpis" id="kpiRow"></div>
      <div class="card pad">
        <div class="sec-title">
          支出结构
          <div class="seg" style="margin-left:auto">
            <button class="active" data-action="chart" data-chart="pie">分类占比</button>
            <button data-action="chart" data-chart="bar">时间趋势</button>
            <button data-action="chart" data-chart="balance">收支结余</button>
            <button data-action="chart" data-chart="rank">排名条形</button>
          </div>
        </div>
        <div class="chart-box"><canvas id="mainChart"></canvas></div>
        <div id="chartNote" class="muted-3" style="font-size:.75rem;margin-top:8px"></div>
      </div>
    </section>

    <!-- ========== 明细 ========== -->
    <section class="pane" id="pane-detail">
      <div class="card pad">
        <div class="sec-title">
          支出明细
          <div class="seg" style="margin-left:auto">
            <button class="active" data-action="view" data-view="day">按天</button>
            <button data-action="view" data-view="month">按月</button>
            <button data-action="view" data-view="year">按年</button>
            <button data-action="view" data-view="category">按分类</button>
          </div>
        </div>
        <div id="detailSummary" class="muted" style="font-size:.8rem;margin-bottom:10px"></div>
        <div class="detail-wrap" id="detailList"></div>
      </div>
      <div class="card pad">
        <div class="sec-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          查找支出
          <span class="hint">支持分类名、备注、金额关键词</span>
        </div>
        <div class="row" style="margin-bottom:10px">
          <div class="money-input" style="flex:1"><input type="text" id="searchKw" placeholder="例如：外卖 / 奶粉 / 京东 / 100" style="padding-left:12px;font-size:.88rem;font-weight:500"></div>
          <button class="btn btn-primary btn-sm" data-action="search">查找</button>
          <button class="btn btn-outline btn-sm" data-action="search-clear">清空</button>
        </div>
        <div class="detail-wrap" id="searchList" style="max-height:380px"></div>
      </div>
    </section>

    <!-- ========== 数据分析与建议 ========== -->
    <section class="pane" id="pane-analysis">
      <div class="card pad">
        <div class="sec-title">
          分析范围
          <div class="row" style="margin-left:auto">
            <select id="scopeSelect" class="btn btn-outline btn-sm" style="padding:6px 10px">
              <option value="current">当前期间</option>
              <option value="3">最近 3 个月</option>
              <option value="6">最近 6 个月</option>
              <option value="year">本年度</option>
              <option value="prev">上一年度</option>
              <option value="all">全部数据</option>
            </select>
            <button class="btn btn-primary btn-sm" data-action="export-report" title="导出为 Markdown 报告">导出报告</button>
          </div>
        </div>
        <div class="score-card">
          <div class="gauge">
            <svg width="132" height="132" viewBox="0 0 132 132">
              <circle cx="66" cy="66" r="56" fill="none" stroke="var(--card-3)" stroke-width="13"/>
              <circle id="gaugeArc" cx="66" cy="66" r="56" fill="none" stroke="var(--primary)" stroke-width="13"
                      stroke-linecap="round" stroke-dasharray="351.86" stroke-dashoffset="351.86" style="transition:stroke-dashoffset .8s cubic-bezier(.4,0,.2,1),stroke .4s"/>
            </svg>
            <div class="g-val"><div class="g-num" id="gaugeNum">—</div><div class="g-lbl" id="gaugeLbl">健康评分</div></div>
          </div>
          <div class="dims" id="dimList"></div>
        </div>
        <div id="scoreVerdict" style="margin-top:16px"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">核心指标 <span class="hint">基于所选范围自动计算</span></div>
        <div class="metric-grid" id="metricGrid"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">自动诊断 <span class="hint">按严重程度排序，每条均附可量化动作</span></div>
        <div class="findings" id="findingList"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">结构分析</div>
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
          <div>
            <div class="muted" style="font-size:.78rem;font-weight:700;margin-bottom:9px">一级分类占比（修正口径）</div>
            <div class="bar-list" id="catBars"></div>
          </div>
          <div>
            <div class="muted" style="font-size:.78rem;font-weight:700;margin-bottom:9px">金额最大的 10 笔</div>
            <div class="tbl-scroll" style="max-height:340px">
              <table class="tbl"><thead><tr><th>日期</th><th>分类</th><th class="n">金额</th><th class="n">占比</th></tr></thead><tbody id="topTable"></tbody></table>
            </div>
          </div>
        </div>
      </div>

      <div class="card pad" id="yoyCard" style="display:none">
        <div class="sec-title">同比对比 <span class="hint" id="yoyHint"></span></div>
        <div id="yoyBody"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">可执行方案 <span class="hint">三档思路，数值按你的真实数据测算</span></div>
        <div class="plan-tabs" id="planTabs"></div>
        <div id="planBodies"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">测算器</div>
        <div class="calc-grid">
          <div class="calc">
            <h4>🏦 应急金要多久</h4>
            <div class="field"><label>刚性月支出（自动估算）</label><input type="number" id="calcRigid" step="1"></div>
            <div class="field"><label>目标月数</label><input type="number" id="calcMonths" value="3" min="1" max="12" step="1"></div>
            <div class="field"><label>每月可存</label><input type="number" id="calcMonthly" step="1"></div>
            <div class="out" id="calcOut1"></div>
          </div>
          <div class="calc">
            <h4>📈 定投复利</h4>
            <div class="field"><label>每月定投（元）</label><input type="number" id="sipAmount" value="1000" step="100"></div>
            <div class="field"><label>预期年化收益（%）</label><input type="number" id="sipRate" value="6" step="0.5"></div>
            <div class="field"><label>年限</label><input type="number" id="sipYears" value="10" step="1" min="1"></div>
            <div class="out" id="calcOut2"></div>
          </div>
          <div class="calc">
            <h4>🎯 目标储蓄率差多少</h4>
            <div class="field"><label>目标储蓄率（%）</label><input type="number" id="goalRate" value="20" step="1" min="0" max="80"></div>
            <div class="out" id="calcOut3"></div>
          </div>
        </div>
      </div>

      <div class="card pad">
        <div class="sec-title">口径设置与数据质量 <span class="hint">决定"哪些不算消费、哪些算一次性"</span></div>
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
          <div class="field">
            <label>不计入消费的二级分类（账户间转移 / 还款，逗号分隔）</label>
            <textarea id="setTransfer" placeholder="信用卡还款, 花呗还款, 车贷, 给老婆"></textarea>
            <div class="muted-3" style="font-size:.71rem;margin-top:5px">这些金额会从"消费"中剔除，但仍计入现金流支出。</div>
          </div>
          <div class="field">
            <label>一次性 / 年度大额的三级分类（逗号分隔）</label>
            <textarea id="setOneOff" placeholder="机票, 物业费, 车辆保险, 消防安全"></textarea>
            <div class="muted-3" style="font-size:.71rem;margin-top:5px">这些应通过"月度计提"覆盖，而不是挤占当月生活预算。</div>
          </div>
        </div>
        <div class="row" style="margin-top:4px">
          <button class="btn btn-outline btn-sm" data-action="scan-keys" style="margin-right:auto">🔍 扫描全部记录并建议</button>
          <button class="btn btn-primary btn-sm" data-action="save-settings">保存口径</button>
        </div>
        <div style="margin-top:12px">
          <div class="muted-3" style="font-size:.72rem;margin-bottom:7px;line-height:1.6">
            扫描结果 —— 点击即加入对应清单，全部分析会立即重算。<br>
            <b>蓝色</b>=账户间转移/还款（从"消费"里剔除）；<b>橙色</b>=一次性大额（纳入月度计提，不计入当月生活水平）。<br>
            仅对<b>三级分类</b>建议一次性大额：二级分类多是复合桶（如「房租物业」同时含月度房租），整体剔除会让分析严重失真。
          </div>
          <div id="keySuggest"></div>
        </div>
        <div class="divider"></div>
        <div id="dqList"></div>
      </div>

      <div class="card pad">
        <div class="sec-title">规则与阈值 <span class="hint">纯本地 · 不上传任何数据 · 改完即重算</span></div>
        <details class="rules" id="rulesDetails">
          <summary>展开调整（阈值 · 方案力度 · 定投假设）—— 默认值基于 2026 年数据分析校准</summary>
          <div class="row" style="margin:12px 0;flex-wrap:wrap">
            <button class="btn btn-primary btn-sm" data-action="save-rules">保存并重算</button>
            <button class="btn btn-outline btn-sm" data-action="reset-rules">恢复默认</button>
            <button class="btn btn-outline btn-sm" data-action="export-rules">导出规则包</button>
            <button class="btn btn-outline btn-sm" data-action="import-rules">导入规则包</button>
            <button class="btn btn-outline btn-sm" data-action="folder-rules">从同目录 rules.json 载入</button>
          </div>
          <div id="rulesBox"></div>
          <div class="callout" style="margin-top:12px;font-size:.79rem">
            改动只影响<b>判断与建议</b>，不影响原始记录。导出的 <b>rules.json</b> 可以放到本 HTML 同目录，换电脑后一键载入；
            用 <code>file://</code> 双击打开时浏览器会拦截本地 fetch，此时请用「导入规则包」按钮。
          </div>
        </details>
      </div>
    </section>

    <!-- ========== 预算 ========== -->
    <section class="pane" id="pane-budget">
      <div class="card pad">
        <div class="sec-title">
          月度预算
          <span class="hint" id="budgetPeriodHint"></span>
        </div>
        <div class="row" style="margin-bottom:14px;flex-wrap:wrap">
          <div class="field" style="margin:0;flex:1;min-width:150px"><label>本月总预算</label><input type="number" id="budTotal" placeholder="例如 7000" step="50"></div>
          <div class="field" style="margin:0;flex:1;min-width:150px"><label>总预算用于所有月份</label><input type="number" id="budDefaultTotal" placeholder="例如 7000" step="50"></div>
          <button class="btn btn-primary btn-sm" data-action="save-budget" style="margin-top:18px">保存</button>
        </div>
        <div id="budTotalBar" style="margin-bottom:6px"></div>
        <div class="divider"></div>
        <div class="muted" style="font-size:.78rem;font-weight:700;margin-bottom:6px">分类预算（留空表示不限制）</div>
        <div id="budCatList"></div>
        <div class="row" style="justify-content:flex-end;margin-top:14px">
          <button class="btn btn-outline btn-sm" data-action="bud-clear">清空本月分类预算</button>
          <button class="btn btn-primary btn-sm" data-action="save-budget">保存预算</button>
        </div>
      </div>
      <div class="card pad">
        <div class="sec-title">预算执行建议</div>
        <div id="budAdvice"></div>
      </div>
    </section>
  </main>
</div>

<!-- ============================ 移动端底栏 ============================ -->
<nav class="mobile-bar">
  <button class="active" data-action="pane" data-pane="record"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>概览</button>
  <button data-action="pane" data-pane="detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>明细</button>
  <button data-action="pane" data-pane="analysis"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><polyline points="7 15 11 10 15 13 20 6"/></svg>分析</button>
  <button data-action="pane" data-pane="budget"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>预算</button>
</nav>

<!-- ============================ 抽屉 ============================ -->
<div class="overlay" id="drawerOverlay" data-action="close-drawer"></div>
<aside class="drawer" id="drawer" aria-label="设置与数据工具">
  <div class="drawer-head">
    <h3>⚙️ 设置与数据</h3>
    <button class="icon-btn" data-action="close-drawer" aria-label="关闭">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="drawer-body">
    <div class="dr-group">本地文件（推荐）</div>
    <button class="dr-btn" data-action="open-file">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      <span>打开本地 JSON 账本<small>绑定后每次改动自动回写磁盘</small></span>
    </button>
    <button class="dr-btn" data-action="save-file">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      <span>另存到磁盘<small>同时成为自动同步目标</small></span>
    </button>
    <div class="dr-group">导入 / 导出</div>
    <button class="dr-btn" data-action="import-json">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span>导入 JSON<small>覆盖当前账本</small></span>
    </button>
    <button class="dr-btn" data-action="export-json">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span>导出 JSON 备份<small>含分类、收入、预算、口径设置</small></span>
    </button>
    <button class="dr-btn" data-action="import-excel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      <span>导入 Excel<small>需含 日期 / 金额 列</small></span>
    </button>
    <button class="dr-btn" data-action="export-excel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      <span>导出 Excel<small>当前所选范围明细</small></span>
    </button>
    <button class="dr-btn" data-action="export-report">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
      <span>导出分析报告<small>Markdown，含诊断与三档方案</small></span>
    </button>
    <div class="dr-group">分类与示例</div>
    <button class="dr-btn" data-action="open-cats">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h6l2 3h10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      <span>管理分类<small>改名、排序、增删三级</small></span>
    </button>
    <button class="dr-btn" data-action="load-demo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v13"/><polyline points="7 11 12 16 17 11"/><path d="M5 20h14"/></svg>
      <span>载入内置参考账本<small>2026-07-27 ~ 10-07，226 条</small></span>
    </button>
    <div class="dr-group">危险操作</div>
    <button class="dr-btn" data-action="wipe" style="color:var(--danger)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
      <span>清空全部数据</span>
    </button>
  </div>
</aside>

<!-- ============================ 分类管理 ============================ -->
<div class="modal" id="catModal">
  <div class="modal-card wide">
    <div class="modal-head">
      <h3>📁 分类管理</h3>
      <button class="icon-btn" data-action="close-cats"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="modal-body" id="catTree"></div>
    <div class="modal-foot">
      <input type="text" id="newCat1" placeholder="新一级分类名称" style="flex:1;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--card-2)">
      <button class="btn btn-primary btn-sm" data-action="add-cat1">添加一级分类</button>
      <button class="btn btn-outline btn-sm" data-action="close-cats">完成</button>
    </div>
  </div>
</div>

<!-- ============================ 通用确认 ============================ -->
<div class="modal" id="confirmModal">
  <div class="modal-card narrow">
    <div class="modal-body" style="text-align:center">
      <div style="font-size:2rem">⚠️</div>
      <div id="confirmTitle" style="font-weight:800;font-size:1rem;margin:8px 0 6px">确认操作</div>
      <div id="confirmMsg" class="muted" style="font-size:.85rem">确定执行吗？</div>
    </div>
    <div class="modal-foot" style="justify-content:center">
      <button class="btn btn-outline" data-action="confirm-no">取消</button>
      <button class="btn btn-danger" data-action="confirm-yes">确定</button>
    </div>
  </div>
</div>

<!-- ============================ 快速新增分类 ============================ -->
<div class="modal" id="quickModal">
  <div class="modal-card narrow">
    <div class="modal-head"><h3 id="quickTitle">快速添加</h3>
      <button class="icon-btn" data-action="quick-close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="field"><label id="quickLabel">名称</label><input type="text" id="quickInput"></div>
      <div class="field" id="quickParentWrap" style="display:none"><label>上级分类</label><select id="quickParent"></select></div>
    </div>
    <div class="modal-foot"><button class="btn btn-primary" data-action="quick-ok">确认添加</button></div>
  </div>
</div>

<div class="toast-wrap" id="toasts"></div>

