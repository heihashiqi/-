  savings: { healthy: 25, good: 20, pass: 15, weak: 10, low: 5 },
  /* 固定成本（房+水电+通信+车）占收入（%） */
  fixed: { good: 35, mid: 42, warn: 50, bad: 58 },
  /* 应急金与刚性支出 */
  emergency: { months: 3, fast: 6, slow: 12, verySlow: 24 },
  rigid: { childShare: 0.85, foodShare: 0.55 },
  /* 恩格尔系数里"购物中的食材"折算比例（与 rigid.foodShare 是两个独立参数） */
  engel: { groceryShare: 0.35 },
  /* 还款类占收入（%） */
  debt: { ok: 5, warn: 10, bad: 20 },
  /* 外卖+零食+娱乐 占"弹性支出"（%） */
  structure: { good: 18, mid: 28, warn: 40, bad: 55 },
  /* 单项警戒 */
  delivery: { warnPct: 30, selfCookSave: 0.4 },
  small: { amount: 15, warnPct: 22, saveRate: 0.45 },
  concentration: { warnPct: 30 },
  comm: { warnMonthly: 80, target: 69 },
  transfer: { warnIncomePct: 8 },
  grocery: { warnMonthly: 300 },
  /* 数据质量（%） */
  data: { coverageWarn: 80, coverageMid: 92, missingIncomePenalty: 12, noIncomePenalty: 25 },
  /* 健康评分分档 */
  verdict: { healthy: 88, good: 74, tight: 60, weak: 45 },
  /* 三档方案：目标储蓄率 + 各项削减力度（0~1） */
  plans: {
    safe:     { target: 20, ratios: { delivery: 0.55, snack: 0.65, grocery: 0.20, comm: 0.40, housing: 0.10, pet: 0.40, entertainment: 0.40 } },
    balanced: { target: 15, ratios: { delivery: 0.35, snack: 0.40, grocery: 0.12, comm: 0.40, housing: 0.05, pet: 0.20, entertainment: 0.20 } },
    growth:   { target: 20, ratios: { delivery: 0.45, snack: 0.50, grocery: 0.18, comm: 0.40, housing: 0.08, pet: 0.35, entertainment: 0.30 } }
  },
  /* 定投假设 */
  sip: { amount: 1500, rate: 6, years: 10 },
  /* 进取型「一次投资，长远省钱」清单
     basis+share = 按对应月均项的百分比折算年省；basis+floor = 降到某月均后的年省；save = 固定年省 */
  invest: [
    { name: '自炊设备（电饭煲 / 空气炸锅 / 保温饭盒）', cost: 800, basis: 'delivery', share: 0.4, note: '把外卖单均压到 ¥10 上下' },
    { name: '空调 / 热水器节能改造 + 定时插座', cost: 1200, save: 660, note: '热带地区电费按 -25% 估算' },
    { name: '奶粉 / 日用品大促锁价囤货', cost: 0, basis: 'child', share: 0.12, note: '618 / 双 11 各囤 3 个月用量' },
    { name: '通信融合套餐重构 + 年付', cost: 0, basis: 'comm', floor: 69, note: '话费降档 + 年付折扣' },
    { name: '机票错峰出行', cost: 0, save: 1200, note: '避开春运 / 寒暑假 / 国庆' },
    { name: '停车费议价或换车位', cost: 0, save: 1200, note: '月租谈到更低档位' },
    { name: '宠物粮大包装', cost: 100, save: 500, note: '单次采购量翻倍' }
  ]
};

/* 合并本地自定义规则（浅层逐组覆盖，避免深拷贝出错） */
function RULES() {
  const u = (Store && Store.settings && Store.settings.rules) || {};
  const r = JSON.parse(JSON.stringify(RULES_DEFAULT));
  ['savings','fixed','emergency','rigid','engel','debt','structure','delivery','small','concentration','comm','transfer','grocery','data','verdict','sip']
    .forEach(function (k) { if (u[k]) Object.assign(r[k], u[k]); });
  if (u.plans) ['safe', 'balanced', 'growth'].forEach(function (k) {
    if (!u.plans[k]) return;
    if (u.plans[k].target != null) r.plans[k].target = Number(u.plans[k].target);
    if (u.plans[k].ratios) Object.assign(r.plans[k].ratios, u.plans[k].ratios);
  });
  if (Array.isArray(u.invest) && u.invest.length) r.invest = JSON.parse(JSON.stringify(u.invest));
  if (u.name) r.name = u.name;
  return r;
}

