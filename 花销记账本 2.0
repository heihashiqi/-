const U = {
  $(s, r) { return (r || document).querySelector(s); },
  $$(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); },
  round2(n) { return Math.round((Number(n) || 0) * 100) / 100; },
  money(n, dec) {
    const d = dec === undefined ? 2 : dec;
    const v = Number(n) || 0;
    return '¥' + v.toLocaleString('zh-CN', { minimumFractionDigits: d, maximumFractionDigits: d });
  },
  moneyShort(n) {
    const v = Number(n) || 0, a = Math.abs(v);
    if (a >= 100000) return '¥' + (v / 10000).toFixed(1) + '万';
    return '¥' + Math.round(v).toLocaleString('zh-CN');
  },
  signMoney(n) { const v = Number(n) || 0; return (v >= 0 ? '+' : '-') + '¥' + Math.abs(v).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); },
  pct(n, d) { return (Number(n) || 0).toFixed(d === undefined ? 1 : d) + '%'; },
  sum(arr, f) { f = f || function (e) { return e.amount; }; return arr.reduce(function (s, e) { return s + (Number(f(e)) || 0); }, 0); },
  sumN(arr) { return (arr || []).reduce(function (s, x) { return s + (Number(x) || 0); }, 0); },
  mean(arr) { return arr && arr.length ? U.sumN(arr) / arr.length : 0; },
  pad(n) { return String(n).padStart(2, '0'); },
  todayISO() { const d = new Date(); return d.getFullYear() + '-' + U.pad(d.getMonth() + 1) + '-' + U.pad(d.getDate()); },
  ymOf(dateStr) { return String(dateStr || '').slice(0, 7); },
  monthLabel(ym) { const p = String(ym).split('-'); return p[0] + '年' + Number(p[1]) + '月'; },
  daysInMonth(y, m) { return new Date(y, m, 0).getDate(); },
  clamp(n, a, b) { return Math.max(a, Math.min(b, n)); },
  uid(p) { return (p || 'exp') + '_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7); },
  esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); },
  uniq(a) { return Array.from(new Set(a)); },
  clone(o) { return JSON.parse(JSON.stringify(o)); },
  parseList(s) { return String(s || '').split(/[,，、\n]/).map(function (x) { return x.trim(); }).filter(Boolean); },
  getPath(o, p) { return String(p).split('.').reduce(function (a, k) { return (a == null ? undefined : a[k]); }, o); },
  setPath(o, p, v) {
    const ks = String(p).split('.');
    let t = o;
    for (let i = 0; i < ks.length - 1; i++) {
      if (typeof t[ks[i]] !== 'object' || t[ks[i]] === null) t[ks[i]] = {};
      t = t[ks[i]];
    }
    t[ks[ks.length - 1]] = v;
    return o;
  },
  debounce(fn, ms) { let t; return function () { const a = arguments, c = this; clearTimeout(t); t = setTimeout(function () { fn.apply(c, a); }, ms || 200); }; },
  download(name, text, mime) {
    const blob = new Blob([text], { type: (mime || 'text/plain') + ';charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
  },
  weekday(ds) { try { return '日一二三四五六'[new Date(ds + 'T00:00:00').getDay()]; } catch (e) { return ''; } },
  uidMonthShift(ym, delta) {
    const p = ym.split('-'); const d = new Date(Number(p[0]), Number(p[1]) - 1 + delta, 1);
    return d.getFullYear() + '-' + U.pad(d.getMonth() + 1);
  },
  monthsBetween(a, b) {
    const pa = a.split('-'), pb = b.split('-');
    return (Number(pb[0]) - Number(pa[0])) * 12 + (Number(pb[1]) - Number(pa[1]));
  }
};

/* ==================================================================
   1. 数据层：IndexedDB
   ================================================================== */
const DB = (function () {
  let db = null;
  function open() {
    return new Promise(function (res, rej) {
      const req = indexedDB.open(CFG.DB, CFG.VER);
      req.onupgradeneeded = function (e) {
        const d = e.target.result;
        function mk(name, keyPath, idx) {
          if (!d.objectStoreNames.contains(name)) {
            const s = d.createObjectStore(name, { keyPath: keyPath });
            if (idx) s.createIndex(idx, idx);
          }
        }
        mk('expenses', 'id', 'date');
        mk('categories', 'id');
        mk('monthlyIncome', 'month');
        mk('meta', 'key');
        mk('budgets', 'month');
        mk('settings', 'key');
      };
      req.onsuccess = function (e) { db = e.target.result; res(db); };
      req.onerror = function (e) { rej(e.target.error); };
      req.onblocked = function () { rej(new Error('数据库被其他标签页占用')); };
    });
  }
  function store(name, mode) { return db.transaction(name, mode).objectStore(name); }
  function wrap(req) { return new Promise(function (res, rej) { req.onsuccess = function () { res(req.result); }; req.onerror = function () { rej(req.error); }; }); }
  function commit(t) { return new Promise(function (res, rej) { t.oncomplete = function () { res(); }; t.onerror = function () { rej(t.error); }; t.onabort = function () { rej(t.error); }; }); }
  return {
    open: open,
    all: function (n) { return wrap(store(n, 'readonly').getAll()); },
    get: function (n, k) { return wrap(store(n, 'readonly').get(k)); },
    put: function (n, v) { const t = db.transaction(n, 'readwrite'); const p = commit(t); t.objectStore(n).put(v); return p; },
    putMany: function (n, arr) { const t = db.transaction(n, 'readwrite'); const p = commit(t); const os = t.objectStore(n); arr.forEach(function (v) { os.put(v); }); return p; },
    del: function (n, k) { const t = db.transaction(n, 'readwrite'); const p = commit(t); t.objectStore(n).delete(k); return p; },
    clear: function (n) { const t = db.transaction(n, 'readwrite'); const p = commit(t); t.objectStore(n).clear(); return p; }
  };
})();

/* ==================================================================
   2. 状态层：Store
   ================================================================== */
const DEFAULT_CATEGORIES = {
  '餐饮': { '早餐': ['家里做','外面早餐店','便利店'], '午餐': ['食堂','外卖','自带便当','餐厅'], '晚餐': ['家里做','外卖','餐厅','聚餐'], '零食饮料': ['超市零食','奶茶咖啡','水果','便利店'], '食材采购': ['菜市场','超市生鲜','生鲜电商'] },
  '交通': { '公共交通': ['公交','地铁','共享单车','火车'], '私家车': ['加油','充电','停车费','保养维修','保险'], '打车出行': ['滴滴','出租车','顺风车'], '机票': ['默认','海航'] },
  '购物': { '日用品': ['超市购物','网购日用品','便利店','抖音购物','拼多多购物'], '服饰美妆': ['衣服','鞋子','化妆品','配饰'], '数码产品': ['手机','电脑','配件','软件'], '家居': ['家具','厨具','装饰','维修'] },
  '娱乐': { '休闲': ['电影','游戏','音乐','书籍'], '运动健身': ['健身房','游泳','球类','器材'], '旅游': ['机票酒店','景点门票','纪念品','餐饮'], '社交': ['聚会','KTV','桌游','礼物'] },
  '住房': { '房租物业': ['房租','物业费','宽带'], '水电燃气': ['水费','电费','燃气费'], '维修': ['管道维修','电器维修','其他维修'], '配套设施': ['默认','消防安全'] },
  '医疗健康': { '看病': ['门诊','急诊','住院','检查'], '药品': ['处方药','非处方药','保健品'], '护理': ['牙科','眼科','体检'] },
  '教育': { '课程': ['线上课程','线下培训','考试报名'], '书籍资料': ['教材','文具','打印'] },
  '子女支出': { '必需品': ['奶粉','儿童牛奶','尿不湿','儿童副食'], '其他': ['默认','玩具','服饰'], '医疗': ['疫苗','体检','看病'] },
  '通信': { '话费': ['默认','联通','移动','电信'], '银行短信费': ['默认','建行'], '其他': ['默认'] },
  '金融': { '信用卡还款': ['默认','招行'], '花呗还款': ['默认'], '车贷': ['默认'], '保险': ['车险','寿险','医疗险'] },
  '其他': { '人情往来': ['红包','礼金','请客'], '宠物': ['宠物粮','医疗','用品'], '杂项': ['快递','其他','剪头发'], '给老婆': ['默认','红包','礼物'] },
  '工作需要': { '其他': ['默认'], '网站会员': ['默认','网络'] }
};

const Store = {
  expenses: [],
  categories: {},
  incomes: {},
  budgets: {},
  settings: { transferKeys: CFG.TRANSFER_DEFAULT.slice(), oneOffKeys: CFG.ONEOFF_DEFAULT.slice(), theme: 'light', defaultBudgetTotal: 0, rules: {} },
  fileHandle: null,

  async load() {
    await DB.open();
    const cats = await DB.all('categories');
    if (cats.length && cats[0].data) this.categories = cats[0].data;
    else { this.categories = U.clone(DEFAULT_CATEGORIES); await DB.put('categories', { id: 'main', data: this.categories }); }
    this.expenses = await DB.all('expenses');
    this.sort();
    const inc = await DB.all('monthlyIncome');
    this.incomes = {};
    inc.forEach(function (i) { Store.incomes[i.month] = i.income; });
    this.budgets = {};
    (await DB.all('budgets')).forEach(function (b) { Store.budgets[b.month] = b; });
    const st = await DB.all('settings');
    st.forEach(function (s) { if (s.key === 'main') Store.settings = Object.assign(Store.settings, s.data || {}); });
    if (!this.settings.transferKeys) this.settings.transferKeys = CFG.TRANSFER_DEFAULT.slice();
    if (!this.settings.oneOffKeys) this.settings.oneOffKeys = CFG.ONEOFF_DEFAULT.slice();
  },
  sort() { this.expenses.sort(function (a, b) { return b.date.localeCompare(a.date) || (b.timestamp || 0) - (a.timestamp || 0); }); },

  async saveSettings() { await DB.put('settings', { key: 'main', data: this.settings }); await this.sync(); },
  async saveCategories() { await DB.put('categories', { id: 'main', data: this.categories }); await this.sync(); },
  async addExpense(e) { await DB.put('expenses', e); this.expenses.push(e); this.sort(); await this.sync(); },
  async removeExpense(id) { await DB.del('expenses', id); this.expenses = this.expenses.filter(function (x) { return x.id !== id; }); await this.sync(); },
  async setIncome(month, income) { this.incomes[month] = income; await DB.put('monthlyIncome', { month: month, income: income }); await this.sync(); },
  async setBudget(month, data) { this.budgets[month] = data; await DB.put('budgets', data); await this.sync(); },
  async delBudget(month) { delete this.budgets[month]; await DB.del('budgets', month); await this.sync(); },

  async sync() {
    if (!this.fileHandle) return;
    try {
      const w = await this.fileHandle.createWritable();
      await w.write(JSON.stringify(this.snapshot(), null, 2));
      await w.close();
    } catch (e) { this.fileHandle = null; }
  },
  snapshot() {
    return { version: 4, exportedAt: new Date().toISOString(), expenses: this.expenses, categories: this.categories, monthlyIncomes: this.incomes, budgets: this.budgets, settings: this.settings };
  },
  async importPayload(data, opts) {
    opts = opts || {};
    if (data.categories) { this.categories = data.categories; await DB.put('categories', { id: 'main', data: this.categories }); }
    const list = data.expenses || data.records || [];
    if (list.length) {
      if (!opts.merge) await DB.clear('expenses');
      const norm = list.map(function (e, i) {
        return {
          id: e.id || U.uid('exp'),
          amount: U.round2(e.amount),
          date: e.date,
          category1: e.category1 || '其他',
          category2: e.category2 || '其他',
          category3: e.category3 || '默认',
          note: e.note || '',
          timestamp: e.timestamp || Date.now() + i
        };
      }).filter(function (e) { return e.date && e.amount > 0; });
      await DB.putMany('expenses', norm);
      this.expenses = opts.merge ? this.expenses.concat(norm) : norm;
      this.sort();
      norm.forEach(function (e) {
        if (!Store.categories[e.category1]) Store.categories[e.category1] = {};
        if (!Store.categories[e.category1][e.category2]) Store.categories[e.category1][e.category2] = [];
        if (Store.categories[e.category1][e.category2].indexOf(e.category3) === -1) Store.categories[e.category1][e.category2].push(e.category3);
      });
      await DB.put('categories', { id: 'main', data: this.categories });
    }
    const inc = data.monthlyIncomes || data.incomes;
    if (inc) { await DB.clear('monthlyIncome'); this.incomes = inc; await DB.putMany('monthlyIncome', Object.keys(inc).map(function (m) { return { month: m, income: inc[m] }; })); }
    if (data.budgets) { await DB.clear('budgets'); this.budgets = data.budgets; await DB.putMany('budgets', Object.keys(data.budgets).map(function (m) { return data.budgets[m]; })); }
    if (data.settings) { this.settings = Object.assign(this.settings, data.settings); await DB.put('settings', { key: 'main', data: this.settings }); }
    await this.sync();
  },
  incomeOf(ym) { return Number(this.incomes[ym]) || 0; },
  isTransfer(e) { return this.settings.transferKeys.indexOf(e.category2) !== -1 || e.category1 === '金融'; },
  isOneOff(e) { return this.settings.oneOffKeys.indexOf(e.category2) !== -1 || this.settings.oneOffKeys.indexOf(e.category3) !== -1; }
};

/* ==================================================================
   3. 分析引擎：Analytics
   ================================================================== */
const Analytics = {
  /* 根据视图与锚点，决定分析范围（返回 {label, months:[ym], list:[expense]}） */
  scope(mode, anchor) {
    const all = Store.expenses;
    if (mode === 'all') {
      const months = U.uniq(all.map(function (e) { return U.ymOf(e.date); })).sort();
      return { label: '全部数据', months: months, list: all.slice() };
    }
    if (mode === 'year' || mode === 'prev') {
      const y = mode === 'prev' ? anchor.year - 1 : anchor.year;
      const months = U.uniq(all.filter(function (e) { return e.date.slice(0, 4) === String(y); }).map(function (e) { return U.ymOf(e.date); })).sort();
      return { label: y + (mode === 'prev' ? ' 年度（上一年）' : ' 年度'), months: months, list: all.filter(function (e) { return e.date.slice(0, 4) === String(y); }) };
    }
    if (mode === '3' || mode === '6') {
      const n = Number(mode);
      const end = anchor.year + '-' + U.pad(anchor.month);
      const months = [];
      for (let i = n - 1; i >= 0; i--) months.push(U.uidMonthShift(end, -i));
      const set = months.reduce(function (a, m) { a[m] = 1; return a; }, {});
      return { label: '最近 ' + n + ' 个月', months: months, list: all.filter(function (e) { return set[U.ymOf(e.date)]; }) };
    }
    const ym = anchor.year + '-' + U.pad(anchor.month);
    return { label: U.monthLabel(ym), months: [ym], list: all.filter(function (e) { return U.ymOf(e.date) === ym; }) };
  },

  compute(sc) {
    const list = sc.list;
    const months = sc.months.length ? sc.months : [U.ymOf(U.todayISO())];
    /* 月均分母只计入“真正有记账的月份”，避免范围内空月份把月均与储蓄率整体拉偏 */
    const dayCount = {};
    list.forEach(function (e) { const mk = U.ymOf(e.date); (dayCount[mk] = dayCount[mk] || {})[e.date] = 1; });
    const activeMonths = months.filter(function (mk) { return dayCount[mk] && Object.keys(dayCount[mk]).length > 0; });
    const mathMonths = activeMonths.length ? activeMonths : months;
    const nMonths = Math.max(1, mathMonths.length);
    const daysPerMonth = {};
    mathMonths.forEach(function (mk) { daysPerMonth[mk] = dayCount[mk] ? Object.keys(dayCount[mk]).length : 0; });
    /* 只记了部分天数的边界月份（如账本首尾），单独提示，避免被当成“低消费月” */
    const partialMonths = mathMonths.filter(function (mk) { return daysPerMonth[mk] > 0 && daysPerMonth[mk] < 25; });

    const RA = RULES();   /* 规则包引用（必须先声明，后面多处使用） */
    const transfer = list.filter(function (e) { return Store.isTransfer(e); });
    const consumption = list.filter(function (e) { return !Store.isTransfer(e); });
    const oneOff = consumption.filter(function (e) { return Store.isOneOff(e); });
    const core = consumption.filter(function (e) { return !Store.isOneOff(e); });

    const incomeOfMonth = months.map(function (mk) { return Store.incomeOf(mk); });
    const monthsWithIncome = incomeOfMonth.filter(function (v) { return v > 0; });
    /* 月均收入必须与月均支出使用同一分母，否则储蓄率会严重失真 */
    const totalIncome = U.sumN(incomeOfMonth);
    const avgIncome = totalIncome / nMonths;

    const totalBook = U.sum(list);
    const totalConsume = U.sum(consumption);
    const totalCore = U.sum(core);
    const totalTransfer = U.sum(transfer);
    const totalOneOff = U.sum(oneOff);

    const avgBook = totalBook / nMonths;
    const avgConsume = totalConsume / nMonths;
    const avgCore = totalCore / nMonths;

    const rateBook = avgIncome > 0 ? (avgIncome - avgBook) / avgIncome * 100 : 0;
    const rateConsume = avgIncome > 0 ? (avgIncome - avgConsume) / avgIncome * 100 : 0;

    /* 分类聚合 */
    function group(arr, key) {
      const m = {};
      arr.forEach(function (e) {
        const k = key(e);
        if (!m[k]) m[k] = { name: k, amount: 0, count: 0 };
        m[k].amount += e.amount; m[k].count++;
      });
      return Object.keys(m).map(function (k) { return m[k]; }).sort(function (a, b) { return b.amount - a.amount; });
    }
    const byL1 = group(consumption, function (e) { return e.category1; });
    const byL1Core = group(core, function (e) { return e.category1; });
    const byL2 = group(consumption, function (e) { return e.category2; });
    const byL3 = group(consumption, function (e) { return e.category1 + ' / ' + e.category2 + ' / ' + e.category3; });
    const byMonth = {};
    list.forEach(function (e) { const m = U.ymOf(e.date); if (!byMonth[m]) byMonth[m] = { income: 0, book: 0, consume: 0, core: 0, count: 0 }; byMonth[m].book += e.amount; byMonth[m].count++; });
    consumption.forEach(function (e) { const m = U.ymOf(e.date); if (byMonth[m]) byMonth[m].consume += e.amount; });
    core.forEach(function (e) { const m = U.ymOf(e.date); if (byMonth[m]) byMonth[m].core += e.amount; });
    months.forEach(function (m) { if (!byMonth[m]) byMonth[m] = { income: 0, book: 0, consume: 0, core: 0, count: 0 }; byMonth[m].income = Store.incomeOf(m); });
    Object.keys(byMonth).forEach(function (m) { byMonth[m].income = Store.incomeOf(m); });

    const byDay = {};
    consumption.forEach(function (e) { byDay[e.date] = (byDay[e.date] || 0) + e.amount; });

    /* 关键比率 */
    function amtBy(pred) { return U.sum(consumption.filter(pred)); }
    const housing = amtBy(function (e) { return e.category1 === '住房'; });
    const child = amtBy(function (e) { return e.category1 === '子女支出'; });
    const comm = amtBy(function (e) { return e.category1 === '通信'; });
    const carFixed = amtBy(function (e) { return e.category1 === '交通' && ['充电','停车费','车辆保险','保险','加油','保养维修'].indexOf(e.category3) !== -1; });
    const food = amtBy(function (e) { return e.category1 === '餐饮'; });
    const grocery = amtBy(function (e) { return e.category1 === '购物' && e.category2 === '日用品' && ['超市购物','网购日用品','拼多多购物','抖音购物'].indexOf(e.category3) !== -1; });
    const delivery = amtBy(function (e) { return CFG.DELIVERY_L3.indexOf(e.category3) !== -1; });
    const deliveryCount = consumption.filter(function (e) { return CFG.DELIVERY_L3.indexOf(e.category3) !== -1; }).length;
    const snack = amtBy(function (e) { return e.category2 === '零食饮料' || e.category2 === '便利店' || e.category3 === '便利店'; });
    const snackCount = consumption.filter(function (e) { return e.category2 === '零食饮料' || e.category3 === '便利店'; }).length;
    const subs = amtBy(function (e) { return CFG.SUBSCRIPTION_L3.indexOf(e.category2) !== -1 || CFG.SUBSCRIPTION_L3.indexOf(e.category3) !== -1; });
    const entertainment = amtBy(function (e) { return e.category1 === '娱乐'; });
    const pet = amtBy(function (e) { return e.category2 === '宠物'; });
    const credit = amtBy(function (e) { return e.category2 === '信用卡还款' || e.category2 === '花呗还款'; }) + transfer.filter(function (e) { return e.category2 === '信用卡还款' || e.category2 === '花呗还款'; }).reduce(function (s, e) { return s + e.amount; }, 0);

    const fixedPool = housing + comm + carFixed;
    const fixedRatio = avgIncome > 0 ? (fixedPool / nMonths) / avgIncome * 100 : 0;
    const rigidMonthly = (housing + child * RA.rigid.childShare + comm + carFixed + food * RA.rigid.foodShare) / nMonths;
    const engel = totalConsume > 0 ? (food + grocery * RA.engel.groceryShare) / totalConsume * 100 : 0;
    const deliveryShare = food > 0 ? delivery / food * 100 : 0;

    const smallTickets = consumption.filter(function (e) { return e.amount < RA.small.amount; });
    const smallShare = consumption.length ? smallTickets.length / consumption.length * 100 : 0;
    const smallAmount = U.sum(smallTickets);

    const sorted = consumption.slice().sort(function (a, b) { return b.amount - a.amount; });
    const top3 = sorted.slice(0, 3);
    const top3Share = totalConsume > 0 ? U.sum(top3) / totalConsume * 100 : 0;

    const days = U.uniq(list.map(function (e) { return e.date; })).length;
    const firstDate = list.length ? list.map(function (e) { return e.date; }).sort()[0] : U.todayISO();
    const lastDate = list.length ? list.map(function (e) { return e.date; }).sort().slice(-1)[0] : U.todayISO();
    const spanDays = Math.max(1, Math.round((new Date(lastDate) - new Date(firstDate)) / 86400000) + 1);
    const coverage = U.clamp(days / spanDays * 100, 0, 100);
    const monthGaps = months.filter(function (m) { return Store.incomeOf(m) <= 0; });
    const earlyShare = (function () {
      let early = 0, tot = 0;
      Object.keys(byDay).forEach(function (d) { const day = Number(d.slice(8, 10)); tot += byDay[d]; if (day <= 10) early += byDay[d]; });
      return tot > 0 ? early / tot * 100 : 0;
    })();

    /* 可选：与上期比较 */
    let prev = null;
    if (sc.months.length === 1) {
      const pym = U.uidMonthShift(sc.months[0], -1);
      const plist = Store.expenses.filter(function (e) { return U.ymOf(e.date) === pym; });
      if (plist.length) {
        const pc = plist.filter(function (e) { return !Store.isTransfer(e); });
        prev = { ym: pym, consume: U.sum(pc), book: U.sum(plist), count: plist.length, income: Store.incomeOf(pym) };
      }
    }

    return {
      scopeLabel: sc.label, months: months, nMonths: nMonths,
      list: list, consumption: consumption, core: core, oneOff: oneOff, transfer: transfer,
      count: list.length, consumeCount: consumption.length,
      totalBook: totalBook, totalConsume: totalConsume, totalCore: totalCore, totalTransfer: totalTransfer, totalOneOff: totalOneOff,
      avgBook: avgBook, avgConsume: avgConsume, avgCore: avgCore,
      avgIncome: avgIncome, incomeMonths: monthsWithIncome.length, totalIncome: totalIncome,
      activeMonths: mathMonths, partialMonths: partialMonths, daysPerMonth: daysPerMonth,
      rateBook: rateBook, rateConsume: rateConsume,
      byL1: byL1, byL1Core: byL1Core, byL2: byL2, byL3: byL3, byMonth: byMonth, byDay: byDay,
      housing: housing, child: child, comm: comm, carFixed: carFixed, food: food, grocery: grocery,
      delivery: delivery, deliveryCount: deliveryCount, snack: snack, snackCount: snackCount, subs: subs,
      entertainment: entertainment, pet: pet, credit: credit,
      fixedPool: fixedPool, fixedRatio: fixedRatio, rigidMonthly: rigidMonthly,
      engel: engel, deliveryShare: deliveryShare, smallShare: smallShare, smallAmount: smallAmount,
      smallCount: smallTickets.length,
      top3Share: top3Share, top3: top3, coverage: coverage, days: days, spanDays: spanDays,
      monthGaps: monthGaps, earlyShare: earlyShare, prev: prev,
      firstDate: firstDate, lastDate: lastDate
    };
  }
};

/* ==================================================================
   4. 洞察引擎：健康评分 / 诊断 / 三档方案 / 测算
   ================================================================== */
const Insights = {
  score(m) {
    const R = RULES();
    const dims = [];

    /* 储蓄率 */
    const r = m.avgIncome > 0 ? m.rateConsume : m.rateBook;
    let s1;
    if (m.avgIncome <= 0) s1 = 40;
    else if (r >= R.savings.healthy) s1 = 100; else if (r >= R.savings.good) s1 = 86;
    else if (r >= R.savings.pass) s1 = 72; else if (r >= R.savings.weak) s1 = 58;
    else if (r >= R.savings.low) s1 = 44; else if (r >= 0) s1 = 30; else s1 = 12;
    dims.push({ key: '储蓄能力', v: s1, note: '修正储蓄率 ' + U.pct(r) + '（健康线 ' + R.savings.good + '%）' });

    /* 固定支出占比 */
    const f = m.fixedRatio;
    let s2 = f <= R.fixed.good ? 100 : f <= R.fixed.mid ? 84 : f <= R.fixed.warn ? 66 : f <= R.fixed.bad ? 46 : 26;
    if (m.avgIncome <= 0) s2 = 50;
    dims.push({ key: '固定支出', v: s2, note: '房租+水电+通信+车 ' + U.pct(f) + ' 收入（不含由计提覆盖的物业费、机票等一次性大额）' });

    /* 流动性与应急金：以“攒够 N 个月刚性支出需要多久”衡量，可执行性最强 */
    const surplus = m.avgIncome - m.avgConsume;
    const need3 = m.rigidMonthly * R.emergency.months;
    const monthsTo3 = surplus > 0 ? need3 / surplus : Infinity;
    let s3 = monthsTo3 <= R.emergency.fast ? 100 : monthsTo3 <= R.emergency.slow ? 78
           : monthsTo3 <= R.emergency.verySlow ? 52 : isFinite(monthsTo3) ? 30 : 12;
    dims.push({
      key: '应急储备', v: s3,
      note: isFinite(monthsTo3)
        ? '攒够 ' + R.emergency.months + ' 个月应急金（' + U.money(need3, 0) + '）需 ' + Math.ceil(monthsTo3) + ' 个月'
        : '月结余为负，无法积累应急金'
    });

    /* 债务与还款 */
    const creditMonthly = m.credit / m.nMonths;
    const creditRatio = m.avgIncome > 0 ? creditMonthly / m.avgIncome * 100 : 0;
    let s4 = creditMonthly <= 0 ? 100 : creditRatio <= R.debt.ok ? 76 : creditRatio <= R.debt.warn ? 52 : creditRatio <= R.debt.bad ? 32 : 16;
    dims.push({ key: '债务健康', v: s4, note: creditMonthly > 0 ? '还款类 ' + U.money(creditMonthly, 0) + '/月' : '无还款类支出' });

    /* 消费弹性 */
    const flex = Math.max(1, m.avgConsume - m.rigidMonthly);
    const wasteShare = (m.delivery + m.snack + m.entertainment) / m.nMonths / flex * 100;
    let s5 = wasteShare <= R.structure.good ? 100 : wasteShare <= R.structure.mid ? 80
           : wasteShare <= R.structure.warn ? 60 : wasteShare <= R.structure.bad ? 40 : 22;
    dims.push({ key: '消费结构', v: s5, note: '外卖+零食+娱乐占弹性支出 ' + U.pct(wasteShare) });

    /* 数据质量 */
    let s6 = 100;
    if (m.coverage < R.data.coverageWarn) s6 -= 25; else if (m.coverage < R.data.coverageMid) s6 -= 10;
    if (m.monthGaps.length) s6 -= Math.min(30, m.monthGaps.length * R.data.missingIncomePenalty);
    if (m.avgIncome <= 0) s6 -= R.data.noIncomePenalty;
    s6 = U.clamp(s6, 0, 100);
    dims.push({ key: '数据完整', v: s6, note: '有记录天数 ' + U.pct(m.coverage, 0) + (m.monthGaps.length ? '，缺收入 ' + m.monthGaps.length + ' 个月' : '') });

    const W = [0.30, 0.20, 0.15, 0.15, 0.10, 0.10];
    const total = Math.round(dims.reduce(function (s, d, i) { return s + d.v * W[i]; }, 0));
    return { total: total, dims: dims };
  },

  verdict(total) {
    const V = RULES().verdict;
    if (total >= V.healthy) return { text: '财务结构健康', cls: 'ok', desc: '收支有余、固定成本可控、有储备能力，可以把精力转向资产配置与收入提升。' };
    if (total >= V.good) return { text: '基本稳健，尚有优化空间', cls: '', desc: '现金流为正但不厚，重点是把弹性支出压出预算，并把偶发大额支出纳入月度计提。' };
    if (total >= V.tight) return { text: '结构性紧绷', cls: 'warn', desc: '固定成本吃掉过多收入，结余被压缩到接近零，任何一次意外都会击穿现金流。' };
    if (total >= V.weak) return { text: '偏弱，存在明显缺口', cls: 'warn', desc: '账面已出现持续净流出，必须先止血（降固定成本 + 停掉高成本负债），再谈储蓄。' };
    return { text: '危险：现金流不可持续', cls: 'danger', desc: '支出长期高于收入、无应急金、有循环负债。优先顺序是：止血 → 建 1 个月缓冲 → 清负债 → 再投资。' };
  },

  findings(m) {
    const out = [];
    function add(sev, icon, title, body, act) { out.push({ sev: sev, icon: icon, title: title, body: body, act: act }); }
    const R = RULES();
    const rate = m.avgIncome > 0 ? m.rateConsume : m.rateBook;
    const surplus = m.avgIncome - m.avgConsume;
    const inc = m.avgIncome;

    /* 0. 先讲清楚数据本身的限制，否则后面所有比率都会被误读（置顶显示） */
    if (inc > 0 && m.incomeMonths < m.nMonths) {
      out.push({
        sev: 'warn', pinned: true, icon: '🧮',
        title: '收入只覆盖 ' + m.incomeMonths + '/' + m.nMonths + ' 个记账月，比率被低估',
        body: '范围内有 ' + (m.nMonths - m.incomeMonths) + ' 个月没有录入收入（' + (m.monthGaps.join('、') || '—') + '），' +
          '月均收入被摊薄为 ' + U.money(inc, 0) + '。储蓄率、固定成本占比等一切与收入挂钩的指标都会偏低，' +
          '甚至会把本来为正的结余显示成赤字。',
        act: '补录这些月份的到手收入；或把分析范围切成"当前期间"，单独看一个完整月，再判断真实水平。'
      });
    }

    /* 1. 收支缺口 */
    if (inc > 0 && m.rateBook < 0 && m.rateConsume < 0) {
      add('critical', '🚨', '两个口径都是净流出',
        '月均收入 ' + U.money(inc, 0) + '。按全部记录口径月均支出 ' + U.money(m.avgBook, 0) + '（储蓄率 ' + U.pct(m.rateBook) + '）；' +
        '即使把还款/转账类剔除，月均消费仍有 ' + U.money(m.avgConsume, 0) + '（储蓄率 ' + U.pct(m.rateConsume) + '）。' +
        '这说明不是记账口径造成的假象，而是真实的收不抵支。',
        '先止血：把"固定成本 + 弹性消费"合计压低约 <b>' + U.money(Math.max(0, m.avgConsume - inc * (1 - R.savings.pass / 100)), 0) + '/月</b>，把月结余拉回正值，再谈储蓄目标。');
    } else if (inc > 0 && m.rateBook < 0) {
      add('warn', '🚨', '账面净流出，差额来自还款与家庭转移',
        '按全部记录口径月均支出 ' + U.money(m.avgBook, 0) + '，高于月均收入 ' + U.money(inc, 0) + '（账面储蓄率 ' + U.pct(m.rateBook) + '）；' +
        '剔除还款与家庭转移后，月均消费 ' + U.money(m.avgConsume, 0) + '，修正储蓄率 ' + U.pct(m.rateConsume) + '。' +
        '两者的差距 ' + U.money(m.avgBook - m.avgConsume, 0) + '/月 就是还款与家庭转移。',
        '关键在这笔钱的最终去向：若进入家庭共同储蓄，你的真实储蓄率是 <b>' + U.pct(m.rateConsume) + '</b>；若被花掉，那就是净流出。先把归属确认清楚，再决定要不要优化。');
    } else if (inc > 0 && rate < R.savings.weak) {
      add('warn', '⚠️', '储蓄率过低（' + U.pct(rate) + '）',
        '按当前规则包，健康线是 ' + R.savings.good + '%，及格线是 ' + R.savings.pass + '%。当前每月只剩 ' + U.money(surplus, 0) + '，一次大额支出就会把这个余额抹平。',
        '把目标设为先到 <b>' + R.savings.pass + '%</b>（每月存 ' + U.money(inc * R.savings.pass / 100, 0) + '），达标后再上 ' + R.savings.good + '%。');
    } else if (inc > 0) {
      add('good', '✅', '储蓄率处于可接受区间（' + U.pct(rate) + '）',
        '每月结余 ' + U.money(surplus, 0) + '，具备建立应急金与定投的基础。',
        '建议把结余固定在发薪日后 3 天内自动划转，避免被消费掉。');
    } else {
      add('warn', '⚠️', '缺少收入记录，无法判断储蓄率',
        '当前范围内的 ' + m.nMonths + ' 个月里只记录了 ' + m.incomeMonths + ' 个月收入，所有比率都会失真。',
        '请在左侧"月度收入"里逐月补录到手收入。');
    }

    /* 2. 固定成本 */
    if (inc > 0 && m.fixedRatio > R.fixed.warn) {
      add('warn', '🏠', '固定成本占收入 ' + U.pct(m.fixedRatio) + '，偏高',
        '住房 ' + U.money(m.housing / m.nMonths, 0) + ' + 通信 ' + U.money(m.comm / m.nMonths, 0) + ' + 车辆固定支出 ' + U.money(m.carFixed / m.nMonths, 0) + ' = ' + U.money(m.fixedPool / m.nMonths, 0) + '/月。' +
        '这部分不随克制而下降，是储蓄率上不去的根本原因。',
        '三条路径：房租议价/换租、通信降档（目标 ≤ ¥' + R.comm.target + '/月）、停车费换位或议价。合计目标 <b>' + U.money(m.fixedPool / m.nMonths * 0.12, 0) + '/月</b>。');
    }

    /* 3. 外卖依赖 */
    if (m.deliveryShare > R.delivery.warnPct && m.delivery > 0) {
      add('warn', '🍜', '外卖依赖度高：餐饮的 ' + U.pct(m.deliveryShare) + ' 花在外卖',
        '范围内外卖 ' + m.deliveryCount + ' 笔、合计 ' + U.money(m.delivery, 0) + '，月均 ' + U.money(m.delivery / m.nMonths, 0) + '，单均 ' + U.money(m.delivery / Math.max(1, m.deliveryCount), 1) + '。',
        '自炊替代 ' + U.pct(R.delivery.selfCookSave * 100, 0) + '，月省 <b>' + U.money(m.delivery / m.nMonths * R.delivery.selfCookSave, 0) + '</b>，年省 <b>' + U.money(m.delivery / m.nMonths * R.delivery.selfCookSave * 12, 0) + '</b>。');
    }

    /* 4. 小额高频 */
    if (m.smallShare > R.small.warnPct) {
      add('info', '🪙', '小额高频消费在漏水：' + U.pct(m.smallShare, 0) + ' 的笔数单笔 < ¥' + R.small.amount,
        '共 ' + m.smallCount + ' 笔、合计 ' + U.money(m.smallAmount, 0) + '，占修正消费 ' + U.pct(m.totalConsume > 0 ? m.smallAmount / m.totalConsume * 100 : 0) + '。单看不多，但它是唯一"无痛感"的支出。',
        '给便利店/零食设单月上限，用零钱账户先充值再消费，月省约 <b>' + U.money(m.smallAmount / m.nMonths * R.small.saveRate, 0) + '</b>。');
    }

    /* 5. 口径污染 */
    if (m.totalTransfer > 0) {
      add('info', '🧾', '记账口径需要修正',
        '范围内有 ' + U.money(m.totalTransfer, 0) + ' 属于账户间转移/还款类（' + U.uniq(m.transfer.map(function (e) { return e.category2; })).join('、') + '）。' +
        '如果这些对应的消费已经逐笔记过账，就会重复计入支出，让月度数字虚高一截。',
        '已在"口径设置"里把还款/转账类剔除出消费口径；如还包含家庭内部转账，建议单列"家庭转移"科目。');
    }

    /* 6. 一次性大额无计提 */
    if (m.totalOneOff > 0) {
      add('warn', '📅', '偶发大额支出没有月度计提',
        '范围内一次性/年度大额共 ' + U.money(m.totalOneOff, 0) + '（' + U.uniq(m.oneOff.map(function (e) { return e.category3; })).join('、') + '），相当于每月 ' + U.money(m.totalOneOff / m.nMonths, 0) + ' 的隐藏成本。' +
        '不做计提时，这些支出会整月击穿预算，看上去像"某个月特别败家"。',
        '开一个"大额准备金"子账户，每月固定转入 <b>' + U.money(Math.max(300, m.totalOneOff / m.nMonths), 0) + '</b>，支出时从该账户出，不挤占生活预算。');
    }

    /* 7. 应急金 */
    const EM = R.emergency;
    const need3 = m.rigidMonthly * EM.months;
    const monthsTo3 = surplus > 0 ? need3 / surplus : Infinity;
    if (inc > 0 && surplus <= 0) {
      add('critical', '🛟', '没有应急储备，且没有形成结余的能力',
        '刚性月支出约 ' + U.money(m.rigidMonthly, 0) + '，' + EM.months + ' 个月缓冲需要 ' + U.money(need3, 0) + '。当前月结余 ' + U.money(surplus, 0) + '，按现状永远到不了这个数。',
        '第一步不是投资，而是把月结余做正。先建 <b>1 个月</b>缓冲（' + U.money(m.rigidMonthly, 0) + '），再滚动到 ' + EM.months + ' 个月。');
    } else if (inc > 0 && monthsTo3 > EM.slow) {
      add('warn', '🛟', '应急金达标需要 ' + Math.ceil(monthsTo3) + ' 个月，太慢',
        '刚性月支出 ' + U.money(m.rigidMonthly, 0) + '，' + EM.months + ' 个月目标 ' + U.money(need3, 0) + '；按当前月结余 ' + U.money(surplus, 0) + ' 计算，需要 ' + Math.ceil(monthsTo3) + ' 个月才能攒够。' +
        '期间只要出现一次失业或大额医疗，就会直接转为负债。',
        '双线推进：一边把月结余提到 <b>' + U.money(Math.max(surplus, need3 / EM.slow), 0) + '</b>（' + EM.slow + ' 个月内达标），一边把应急金放在货币基金，只追求流动性，不追求收益。');
    } else if (inc > 0 && isFinite(monthsTo3)) {
      add('good', '🛟', '应急金路径清晰：约 ' + Math.ceil(monthsTo3) + ' 个月可达标',
        '刚性月支出 ' + U.money(m.rigidMonthly, 0) + '，' + EM.months + ' 个月目标 ' + U.money(need3, 0) + '，按当前结余 ' + U.money(surplus, 0) + ' 可在 ' + Math.ceil(monthsTo3) + ' 个月内完成。',
        '达标前不做任何有波动的投资；达标后再开始定投。');
    }

    /* 8. 收入单一 */
    if (inc > 0) add('info', '💼', '收入来源单一（100% 工资）',
      '月均到手 ' + U.money(inc, 0) + '，无被动收入记录。单点故障意味着失业或降薪会立刻传导到全部支出。',
      '两条线并行：把技能变现做一条副业现金流（目标 +' + U.money(Math.max(500, inc * 0.1), 0) + '/月）；同时给唯一收入来源配齐保障（百万医疗 + 意外 + 定期寿险，合计约 ¥1,000~1,500/年）。');

    /* 9. 通信异常 */
    if (m.comm / m.nMonths > R.comm.warnMonthly) {
      add('info', '📱', '通信支出偏高（' + U.money(m.comm / m.nMonths, 0) + '/月）',
        '单卡正常区间 ¥39~79/月。若含宽带融合则需看单价是否比自己单买更贵。',
        '换成流量型套餐或宽带手机融合，目标 ≤ ¥' + R.comm.target + '/月，年省 <b>' + U.money(Math.max(0, m.comm / m.nMonths - R.comm.target) * 12, 0) + '</b>。');
    }

    /* 10. 大额集中度 */
    if (m.top3Share > R.concentration.warnPct) {
      add('info', '📊', '支出高度集中在少数几笔（Top3 占 ' + U.pct(m.top3Share) + '）',
        '最大三笔：' + m.top3.map(function (e) { return e.date.slice(5) + ' ' + e.category3 + ' ' + U.money(e.amount, 0); }).join('；') + '。',
        '这是"现金流脉冲"特征：用计提 + 月初留足资金来平滑，不要在月中透支。');
    }

    /* 11. 订阅制 */
    if (m.subs > 0) {
      add('info', '🔁', '存在订阅制支出 ' + U.money(m.subs, 0) + '（' + U.money(m.subs / m.nMonths, 0) + '/月）',
        '订阅是最容易被遗忘的持续性支出，年化 ' + U.money(m.subs / m.nMonths * 12, 0) + '。',
        '逐项问"这个月用过吗"，用不上的立即取消，能年付的改年付拿折扣。');
    }

    /* 12. 数据质量 */
    if (m.coverage < R.data.coverageWarn || m.monthGaps.length) {
      add('info', '📝', '数据完整性不足，会让分析失真',
        '有记录天数占比 ' + U.pct(m.coverage, 0) + '，缺收入记录的月份 ' + m.monthGaps.length + ' 个' + (m.monthGaps.length ? '（' + m.monthGaps.join('、') + '）' : '') + '。',
        '建议：固定账单（房租/物业/水电/话费/保险/停车）用自动扣款并当天补记；大额支出当天记；每天花 30 秒核对。');
    }

    /* 13. 分类错记 */
    if (m.grocery / Math.max(1, m.nMonths) > R.grocery.warnMonthly) {
      add('info', '🥬', '食材采购被记进了"购物/日用品"',
        '"购物/日用品"月均 ' + U.money(m.grocery / m.nMonths, 0) + '，其中含肉菜蛋奶等食材（如"京东肉菜""鸡胸肉""牛肉面"）。' +
        '混在一起会让餐饮支出被低估、"日用品"被高估，恩格尔系数也算不准。',
        '新增三级分类"餐饮 / 食材采购 / 菜市场·超市生鲜·生鲜电商"，把食材独立出来。');
    }

    /* 14. 家庭内部转移（给配偶/亲情支付）—— 最容易混淆口径的项目 */
    const transferMonthly = m.totalTransfer / m.nMonths;
    if (inc > 0 && transferMonthly > inc * R.transfer.warnIncomePct / 100) {
      add('warn', '🏡', '家庭内部转移 ' + U.money(transferMonthly, 0) + '/月，占收入 ' + U.pct(transferMonthly / inc * 100),
        '范围内的"给老婆/亲情支付"类共 ' + U.money(m.totalTransfer, 0) + '。这部分钱离开了你的账户，但未必被消费掉——它既不是你的消费，也不等于你的储蓄。' +
        '如果它被配偶花掉了，家庭总支出其实比你账面更高；如果它进了家庭共同账户，你的真实储蓄率比账面更好。',
        '和配偶约定一个固定转账额度，并明确这笔钱的归属：<b>共同储蓄</b>（计入结余）还是 <b>家庭支出</b>（计入消费）。归属不清时，任何记账分析都会失真。');
    }

    /* 15. 边界月份记账不完整 */
    if (m.partialMonths && m.partialMonths.length) {
      add('info', '🗓️', '存在记账不完整的月份：' + m.partialMonths.join('、'),
        m.partialMonths.map(function (k) { return k + ' 只记了 ' + m.daysPerMonth[k] + ' 天'; }).join('；') +
        '。这些月份的金额被低估，如果与完整月份放在一起做月均，会拉低整体水平、并让分类占比失真。',
        '做月度对比时把它们排除（改用"最近 3 个月"或单独看某个完整月），或把缺失日期的数据补齐。');
    }

    const order = { critical: 0, warn: 1, info: 2, good: 3 };
    out.sort(function (a, b) {
      if (!!b.pinned !== !!a.pinned) return (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0);
      return order[a.sev] - order[b.sev];
    });
    return out;
  },

  /* 智能口径识别：从实际记录里找出"应算转账"或"应算一次性大额"的分类名 */
  suggestKeys() {
    const TX = /还款|还贷|花呗|白条|借呗|借贷|转账|红包|礼金|随礼|压岁|份子|亲情|给老婆|给老公|给爸|给妈|给父母|给家里|给家人|家用|生活费|赡养|车贷|房贷|分期|信用卡/;
    const OO = /机票|火车票|车票|船票|保险|物业|年费|年卡|学费|培训|报名|考试|体检|牙|眼科|配镜|眼镜|家电|空调|冰箱|洗衣机|热水器|家具|装修|施工|维修|旅行|旅游|门票|会员|订阅|宽带|光猫|安装|疫苗|住院|手术|挂号/;
    const amt2 = {}, amt3 = {};
    Store.expenses.forEach(function (e) {
      amt2[e.category2] = (amt2[e.category2] || 0) + e.amount;
      amt3[e.category3] = (amt3[e.category3] || 0) + e.amount;
    });
    const tk = Store.settings.transferKeys || [];
    const ok = Store.settings.oneOffKeys || [];
    const out = { transfer: [], oneOff: [] };
    const seen = {};
    const L1 = Object.keys(Store.categories);
    /* 安全护栏：二级分类往往是"复合桶"（例：「房租物业」里既有月度房租、又有年度物业费），
       整体剔出消费口径会造成严重失真，因此二级只接受"转账/还款"类强特征，
       并且任何含"房租 / 月租 / 月付"的复合名一律不参与。 */
    function consider(key, amount, level) {
      if (!key || seen[key]) return;
      if (tk.indexOf(key) !== -1 || ok.indexOf(key) !== -1) return;
      if (L1.indexOf(key) !== -1) return;
      if (/房租|月租|月付|月供/.test(key)) return;
      let kind = null;
      if (TX.test(key)) kind = 'transfer';
      else if (level === 3 && OO.test(key)) kind = 'oneOff';
      if (!kind) return;
      seen[key] = 1;
      out[kind].push({ key: key, amount: amount, level: level });
    }
    Object.keys(amt2).forEach(function (k) { consider(k, amt2[k], 2); });
    Object.keys(amt3).forEach(function (k) { consider(k, amt3[k], 3); });
    out.transfer.sort(function (a, b) { return b.amount - a.amount; });
    out.oneOff.sort(function (a, b) { return b.amount - a.amount; });
    return out;
  },

  /* 三档方案 */
  plans(m) {
    const R = RULES();
    const inc = m.avgIncome > 0 ? m.avgIncome : m.avgBook;
    const base = {
      delivery: m.delivery / m.nMonths, snack: m.snack / m.nMonths,
      grocery: m.grocery / m.nMonths, comm: m.comm / m.nMonths,
      housing: m.housing / m.nMonths, pet: m.pet / m.nMonths,
      entertainment: m.entertainment / m.nMonths, child: m.child / m.nMonths,
      food: m.food / m.nMonths
    };
    const cuts = [
      { key: 'delivery', name: '外卖（自炊替代）', r: 0.50 },
      { key: 'snack', name: '零食饮料 / 便利店', r: 0.60 },
      { key: 'grocery', name: '日用品与食材采购优化', r: 0.18 },
      { key: 'comm', name: '通信套餐重构', r: 0.40 },
      { key: 'housing', name: '房租/物业议价或换租', r: 0.08 },
      { key: 'pet', name: '宠物开支优化', r: 0.35 },
      { key: 'entertainment', name: '娱乐支出', r: 0.30 }
    ];
    function build(planKey) {
      const cfg = R.plans[planKey] || {};
      const ratios = cfg.ratios || {};
      const rows = cuts.map(function (c) {
        const cur = base[c.key] || 0;
        const r = ratios[c.key] !== undefined ? ratios[c.key] : c.r;
        return { name: c.name, cur: cur, target: cur * (1 - r), save: cur * r, ratio: r };
      }).filter(function (x) { return x.cur > 0.5; });
      const save = rows.reduce(function (s, x) { return s + x.save; }, 0);
      const newExpense = m.avgConsume - save;
      const surplus = inc - newExpense;
      const rate = inc > 0 ? surplus / inc * 100 : 0;
      return { rows: rows, save: save, newExpense: newExpense, surplus: surplus, rate: rate, targetRate: cfg.target, inc: inc };
    }
    const safe = build('safe'), balanced = build('balanced'), growth = build('growth');
    /* 进取型投入清单：支持 basis+share（按比例）、basis+floor（降到某月均）、或固定 save */
    const invest = (R.invest || []).map(function (x) {
      let save = Number(x.save) || 0;
      if (x.basis && base[x.basis] != null) {
        save = (x.floor != null)
          ? Math.max(0, base[x.basis] - Number(x.floor)) * 12
          : base[x.basis] * (Number(x.share) || 0) * 12;
      }
      return { name: x.name, cost: Number(x.cost) || 0, save: Math.round(save), note: x.note || '' };
    }).filter(function (x) { return x.save > 0; });
    const investCost = invest.reduce(function (s, x) { return s + x.cost; }, 0);
    const investSave = invest.reduce(function (s, x) { return s + x.save; }, 0);
    return { safe: safe, balanced: balanced, growth: growth, invest: invest, investCost: investCost, investSave: investSave, base: base };
  },

  sip(monthly, ratePct, years) {
    const r = (Number(ratePct) || 0) / 100 / 12;
    const n = Math.max(1, Math.round((Number(years) || 0) * 12));
    const P = Number(monthly) || 0;
    const fv = r > 0 ? P * (Math.pow(1 + r, n) - 1) / r : P * n;
    return { fv: fv, principal: P * n, gain: fv - P * n, n: n };
  }
};

/* ==================================================================
   5. 视图层：UI
   ================================================================== */
const State = {
  pane: 'record',
  view: 'day',
  chart: 'pie',
  scope: 'current',
  year: new Date().getFullYear(),
  month: new Date().getMonth() + 1,
  meta: null,
  plan: 'safe',
  confirmCb: null,
  quickLevel: 1,
  calcSig: null,
  nudgeOff: false
};

const UI = {
  /* ---------- Toast ---------- */
  toast(msg) {
    const el = document.createElement('div');
    el.className = 'toast'; el.textContent = msg;
    U.$('#toasts').appendChild(el);
    setTimeout(function () { el.classList.add('out'); setTimeout(function () { el.remove(); }, 260); }, 2200);
  },
  confirm(title, msg, cb) {
    U.$('#confirmTitle').textContent = title || '确认操作';
    U.$('#confirmMsg').innerHTML = msg || '确定执行吗？';
    State.confirmCb = cb;
    U.$('#confirmModal').classList.add('open');
  },
  closeConfirm() { U.$('#confirmModal').classList.remove('open'); State.confirmCb = null; },

  /* ---------- 期间标签 ---------- */
  periodLabel() {
    if (State.view === 'year') return State.year + ' 年';
    return State.year + '年' + State.month + '月';
  },

  /* ---------- 级联分类 ---------- */
  fillCascade() {
    const s1 = U.$('#catL1'), s2 = U.$('#catL2'), s3 = U.$('#catL3');
    const v1 = s1.value, v2 = s2.value, v3 = s3.value;
    s1.innerHTML = '<option value="">选择一级</option>' + Object.keys(Store.categories).map(function (k) { return '<option>' + U.esc(k) + '</option>'; }).join('');
    s1.value = Store.categories[v1] ? v1 : '';
    const c1 = s1.value;
    s2.disabled = !c1;
    s2.innerHTML = '<option value="">选择二级</option>' + (c1 && Store.categories[c1] ? Object.keys(Store.categories[c1]).map(function (k) { return '<option>' + U.esc(k) + '</option>'; }).join('') : '');
    s2.value = (c1 && Store.categories[c1] && Store.categories[c1][v2]) ? v2 : '';
    const c2 = s2.value;
    s3.disabled = !c2;
    s3.innerHTML = '<option value="">选择三级</option>' + (c1 && c2 && Store.categories[c1] && Store.categories[c1][c2] ? Store.categories[c1][c2].map(function (k) { return '<option>' + U.esc(k) + '</option>'; }).join('') : '');
    s3.value = (c1 && c2 && Store.categories[c1] && Store.categories[c1][c2] && Store.categories[c1][c2].indexOf(v3) !== -1) ? v3 : '';
  },

  /* ---------- KPI ---------- */
  renderKpis(m) {
    const box = U.$('#kpiRow');
    const inc = m.avgIncome;
    const rate = inc > 0 ? (inc > 0 ? m.rateConsume : 0) : 0;
    const cards = [
      { l: '总支出（全部记录）', v: U.money(m.totalBook), s: m.count + ' 笔 · 月均 ' + U.money(m.avgBook, 0), cls: 'accent-exp' },
      { l: '修正消费口径', v: U.money(m.totalConsume), s: '剔除还款/转账 ' + U.money(m.totalTransfer, 0), cls: '' },
      { l: '月均收入', v: inc > 0 ? U.money(inc, 0) : '未录入', s: m.incomeMonths + '/' + m.nMonths + ' 个记账月有收入', cls: '' },
      { l: '月均结余', v: inc > 0 ? U.signMoney(inc - m.avgConsume) : '—', s: inc > 0 ? '储蓄率 ' + U.pct(m.rateConsume) : '需先录入收入', cls: (inc - m.avgConsume) >= 0 ? 'accent-ok' : 'accent-bad' },
      { l: '最大支出分类', v: m.byL1.length ? m.byL1[0].name : '—', s: m.byL1.length ? U.money(m.byL1[0].amount, 0) + ' · ' + U.pct(m.totalConsume > 0 ? m.byL1[0].amount / m.totalConsume * 100 : 0) : '', cls: '' },
      { l: '一次性大额', v: U.money(m.totalOneOff), s: '折旧 ' + U.money(m.totalOneOff / m.nMonths, 0) + '/月 计提', cls: '' }
    ];
    box.innerHTML = cards.map(function (c) {
      return '<div class="kpi ' + c.cls + '"><div class="k-top"><span class="dot"></span>' + c.l + '</div>' +
        '<div class="k-val">' + c.v + '</div><div class="k-sub">' + c.s + '</div></div>';
    }).join('');
  },

  /* ---------- 图表 ---------- */
  chart: null,
  renderChart(m) {
    const cv = U.$('#mainChart');
    const note = U.$('#chartNote');
    if (typeof Chart === 'undefined') { note.textContent = '图表库未加载（离线环境），可用"排名条形"与明细表查看同样信息。'; return; }
    if (this.chart) { this.chart.destroy(); this.chart = null; }
    const ctx = cv.getContext('2d');
    const gridColor = getComputedStyle(document.body).getPropertyValue('--border') || '#eee';
    const tickColor = getComputedStyle(document.body).getPropertyValue('--text-2') || '#666';
    const baseOpts = {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { color: tickColor, boxWidth: 11, padding: 12, font: { size: 11 } } } },
      scales: { x: { ticks: { color: tickColor, font: { size: 10 } }, grid: { color: gridColor } }, y: { ticks: { color: tickColor, font: { size: 10 } }, grid: { color: gridColor } } }
    };
    let cfg = null;
    const type = State.chart;

    if (type === 'pie') {
      const rows = m.byL1.filter(function (r) { return r.amount > 0; });
      if (!rows.length) { note.textContent = '当前范围没有可分析的消费记录。'; return; }
      cfg = {
        type: 'doughnut',
        data: { labels: rows.map(function (r) { return r.name; }), datasets: [{ data: rows.map(function (r) { return U.round2(r.amount); }), backgroundColor: CFG.PALETTE, borderWidth: 0 }] },
        options: Object.assign({}, baseOpts, { cutout: '58%', plugins: Object.assign({}, baseOpts.plugins, { tooltip: { callbacks: { label: function (c) { const t = c.dataset.data.reduce(function (a, b) { return a + b; }, 0); return c.label + ' ' + U.money(c.raw, 0) + ' (' + U.pct(c.raw / t * 100) + ')'; } } } }) })
      };
      note.textContent = '修正口径（已剔除还款/转账）一级分类占比，共 ' + rows.length + ' 类。';
    } else if (type === 'bar') {
      const keys = Object.keys(m.byDay).sort();
      if (!keys.length) { note.textContent = '当前范围没有消费记录。'; return; }
      const isMonthView = m.months.length > 1;
      let labels, data, title;
      if (isMonthView) {
        labels = m.months; data = m.months.map(function (k) { return U.round2(m.byMonth[k] ? m.byMonth[k].consume : 0); }); title = '每月消费（修正口径）';
      } else {
        labels = keys.map(function (k) { return k.slice(5); }); data = keys.map(function (k) { return U.round2(m.byDay[k]); }); title = '每日消费';
      }
      cfg = { type: 'bar', data: { labels: labels, datasets: [{ label: title, data: data, backgroundColor: CFG.PALETTE[0], borderRadius: 5, maxBarThickness: 26 }] }, options: baseOpts };
      note.textContent = title + '：峰值日往往由房租/大额采购造成，注意月初现金流。';
    } else if (type === 'balance') {
      const keys = Object.keys(m.byMonth).sort();
      if (!keys.length) { note.textContent = '没有可用的月份数据。'; return; }
      cfg = {
        type: 'bar',
        data: {
          labels: keys,
          datasets: [
            { label: '收入', data: keys.map(function (k) { return U.round2(m.byMonth[k].income); }), backgroundColor: 'rgba(15,157,118,.85)', borderRadius: 5 },
            { label: '支出', data: keys.map(function (k) { return U.round2(m.byMonth[k].book); }), backgroundColor: 'rgba(224,122,0,.85)', borderRadius: 5 },
            { label: '结余', type: 'line', data: keys.map(function (k) { return U.round2(m.byMonth[k].income - m.byMonth[k].book); }), borderColor: '#2f6bff', backgroundColor: '#2f6bff', tension: .3, pointRadius: 3, borderWidth: 2 }
          ]
        },
        options: baseOpts
      };
      note.textContent = '收入/支出为账面口径；结余线在 0 以下即为当月净流出。';
    } else if (type === 'rank') {
      const rows = m.byL1Core.slice(0, 9);
      if (!rows.length) { note.textContent = '当前范围没有消费记录。'; return; }
      cfg = {
        type: 'bar',
        data: { labels: rows.map(function (r) { return r.name; }), datasets: [{ label: '金额', data: rows.map(function (r) { return U.round2(r.amount); }), backgroundColor: CFG.PALETTE, borderRadius: 5, maxBarThickness: 20 }] },
        options: Object.assign({}, baseOpts, { indexAxis: 'y', plugins: { legend: { display: false } } })
      };
      note.textContent = '常态消费排名（已剔除一次性大额），用于锁定优先优化对象。';
    }
    if (cfg) this.chart = new Chart(ctx, cfg);
  },

  /* ---------- 明细 ---------- */
  renderDetail(m) {
    const box = U.$('#detailList');
    const sum = U.$('#detailSummary');
    sum.innerHTML = '范围：<b>' + U.esc(m.scopeLabel) + '</b> · ' + m.count + ' 条 · 账面 <b>' + U.money(m.totalBook) + '</b> · 修正消费 <b>' + U.money(m.totalConsume) + '</b>';
    const list = m.list;
    if (!list.length) { box.innerHTML = '<div class="empty">该范围暂无记录</div>'; return; }

    function recRow(e) {
      const isTr = Store.isTransfer(e);
      const tag = isTr ? '<span class="tagx">转账/还款</span>' : (Store.isOneOff(e) ? '<span class="tagx">一次性</span>' : '');
      return '<div class="rec">' +
        '<span class="r-main"><span class="r-cat">' + U.esc(e.category1) + ' / ' + U.esc(e.category2) + ' / ' + U.esc(e.category3) + tag + '</span>' +
        (e.note ? '<span class="r-note">' + U.esc(e.note) + '</span>' : '') + '</span>' +
        '<span class="r-amt' + (isTr ? ' is-transfer' : '') + '">-¥' + Number(e.amount).toFixed(2) + '</span>' +
        '<button class="icon-btn r-del" data-action="del-exp" data-id="' + e.id + '" title="删除">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button></div>';
    }

    if (State.view === 'day' || State.view === 'month' || State.view === 'current') {
      const g = {};
      list.forEach(function (e) { (g[e.date] = g[e.date] || []).push(e); });
      box.innerHTML = Object.keys(g).sort().reverse().map(function (d) {
        const rows = g[d];
        const t = U.sum(rows);
        return '<div class="day-head"><span>📅 ' + d + ' 周' + U.weekday(d) + '</span><span class="dh-r">' + U.money(t) + '</span></div>' + rows.map(recRow).join('');
      }).join('');
    } else if (State.view === 'year') {
      const g = {};
      list.forEach(function (e) { const k = U.ymOf(e.date); (g[k] = g[k] || []).push(e); });
      box.innerHTML = Object.keys(g).sort().reverse().map(function (k) {
        const rows = g[k];
        return '<div class="day-head"><span>📅 ' + U.monthLabel(k) + '</span><span class="dh-r">' + U.money(U.sum(rows)) + ' · ' + rows.length + ' 笔</span></div>' +
          rows.slice().sort(function (a, b) { return b.date.localeCompare(a.date); }).map(recRow).join('');
      }).join('');
    } else {
      const g = {};
      list.forEach(function (e) { const k = e.category1 + ' / ' + e.category2 + ' / ' + e.category3; (g[k] = g[k] || []).push(e); });
      const rows = Object.keys(g).map(function (k) { return { k: k, v: U.sum(g[k]), c: g[k].length }; }).sort(function (a, b) { return b.v - a.v; });
      box.innerHTML = '<table class="tbl"><thead><tr><th>分类</th><th class="n">笔数</th><th class="n">金额</th><th class="n">均笔</th><th class="n">占比</th></tr></thead><tbody>' +
        rows.map(function (r) {
          return '<tr><td>' + U.esc(r.k) + '</td><td class="n">' + r.c + '</td><td class="n">' + U.money(r.v) + '</td><td class="n">' + U.money(r.v / r.c, 1) + '</td><td class="n">' + U.pct(m.totalBook > 0 ? r.v / m.totalBook * 100 : 0) + '</td></tr>';
        }).join('') + '</tbody></table>';
    }
  },

  renderRecent() {
    const list = Store.expenses.slice(0, 5);
    U.$('#recentList').innerHTML = list.length ? list.map(function (e) {
      return '<div class="rec"><span class="r-main"><span class="r-cat">' + U.esc(e.category3) + '</span><span class="r-note">' + e.date + ' · ' + U.esc(e.category1) + '</span></span><span class="r-amt">-¥' + Number(e.amount).toFixed(2) + '</span><span></span></div>';
    }).join('') : '<div class="empty">暂无记录</div>';
  },

  /* ---------- 分析面板 ---------- */
  renderAnalysis() {
    const sc = Analytics.scope(State.scope, { year: State.year, month: State.month });
    const m = Analytics.compute(sc);
    State.meta = m;

    /* 评分 */
    const s = Insights.score(m);
    const verdict = Insights.verdict(s.total);
    const circ = 2 * Math.PI * 56;
    const arc = U.$('#gaugeArc');
    arc.setAttribute('stroke-dasharray', circ.toFixed(2));
    arc.setAttribute('stroke-dashoffset', (circ * (1 - s.total / 100)).toFixed(2));
    const col = s.total >= 74 ? 'var(--ok)' : s.total >= 60 ? 'var(--warn)' : 'var(--danger)';
    arc.setAttribute('stroke', col);
    U.$('#gaugeNum').textContent = s.total;
    U.$('#gaugeNum').style.color = col;
    U.$('#gaugeLbl').textContent = verdict.text;

    U.$('#dimList').innerHTML = s.dims.map(function (d) {
      const c = d.v >= 74 ? 'var(--ok)' : d.v >= 55 ? 'var(--warn)' : 'var(--danger)';
      return '<div class="dim" title="' + U.esc(d.note) + '"><span class="d-name">' + d.key + '</span>' +
        '<span class="d-track"><span class="d-fill" style="width:' + d.v + '%;background:' + c + '"></span></span>' +
        '<span class="d-val" style="color:' + c + '">' + d.v + '</span></div>';
    }).join('');

    U.$('#scoreVerdict').innerHTML = '<div class="callout ' + (verdict.cls === 'ok' ? 'ok' : verdict.cls === 'danger' ? 'danger' : verdict.cls === 'warn' ? 'warn' : '') + '">' +
      '<b>' + verdict.text + '（' + s.total + '/100）</b> · ' + verdict.desc + '<br>' +
      '范围：' + U.esc(m.scopeLabel) + '（' + m.nMonths + ' 个月）｜ 月均收入 ' + (m.avgIncome > 0 ? U.money(m.avgIncome, 0) : '未录入') +
      ' ｜ 月均修正消费 ' + U.money(m.avgConsume, 0) + ' ｜ 月均结余 ' + (m.avgIncome > 0 ? U.signMoney(m.avgIncome - m.avgConsume) : '—') +
      ((m.incomeMonths < m.nMonths) ? '<br><b>数据注意：</b>有 ' + (m.nMonths - m.incomeMonths) + ' 个记账月没有收入记录，与收入相关的比率被低估；建议补齐收入或改用单月范围。' : '') +
      ((m.partialMonths && m.partialMonths.length) ? '<br><b>数据注意：</b>' + m.partialMonths.join('、') + ' 的记账天数不足（' + m.partialMonths.map(function (k) { return m.daysPerMonth[k] + ' 天'; }).join('、') + '），月均被拉低。' : '') +
      '</div>';

    /* 指标 */
    const inc = m.avgIncome;
    const metrics = [
      { l: '修正储蓄率', v: inc > 0 ? U.pct(m.rateConsume) : '—', n: '剔除还款/转账后的结余率，健康线 20%' },
      { l: '账面储蓄率', v: inc > 0 ? U.pct(m.rateBook) : '—', n: '包含全部记录支出' },
      { l: '固定成本占比', v: inc > 0 ? U.pct(m.fixedRatio) : '—', n: '房租+水电+通信+车辆固定，建议 ≤40%' },
      { l: '刚性月支出', v: U.money(m.rigidMonthly, 0), n: '剔除弹性消费后的生存成本' },
      { l: '弹性可压缩空间', v: U.money(Math.max(0, m.avgConsume - m.rigidMonthly), 0), n: '本月可动用的最大优化余地' },
      { l: '恩格尔系数（修正）', v: U.pct(m.engel), n: '餐饮+食材占消费，<30% 属宽裕' },
      { l: '外卖占比', v: U.pct(m.deliveryShare), n: m.deliveryCount + ' 笔 · 月均 ' + U.money(m.delivery / m.nMonths, 0) },
      { l: '小额高频占比', v: U.pct(m.smallShare, 0), n: m.smallCount + ' 笔 <¥15，合计 ' + U.money(m.smallAmount, 0) },
      { l: '大额集中度 Top3', v: U.pct(m.top3Share), n: '前三大笔占修正消费' },
      { l: '月初 1-10 日占比', v: U.pct(m.earlyShare), n: '现金流脉冲指标' },
      { l: '日均消费', v: U.money(m.totalConsume / Math.max(1, m.days), 0), n: '按有记录天数计' },
      { l: '数据覆盖', v: U.pct(m.coverage, 0), n: m.days + '/' + m.spanDays + ' 天有记录' }
    ];
    U.$('#metricGrid').innerHTML = metrics.map(function (x) {
      return '<div class="metric"><div class="m-lbl">' + x.l + '</div><div class="m-val">' + x.v + '</div><div class="m-note">' + x.n + '</div></div>';
    }).join('');

    /* 诊断 */
    const fs = Insights.findings(m);
    U.$('#findingList').innerHTML = fs.length ? fs.map(function (f) {
      const ico = { critical: '🚨', warn: '⚠️', info: '💡', good: '✅' }[f.sev] || '•';
      const lbl = { critical: '严重', warn: '注意', info: '提示', good: '良好' }[f.sev];
      return '<div class="finding sev-' + f.sev + (f.pinned ? ' pinned' : '') + '"><div class="f-ico">' + (f.icon || ico) + '</div><div>' +
        '<div class="f-title">' + f.title + '<span class="chip ' + (f.sev === 'critical' ? 'chip-danger' : f.sev === 'warn' ? 'chip-warn' : f.sev === 'good' ? 'chip-ok' : 'chip-info') + '">' + lbl + '</span></div>' +
        '<div class="f-body">' + f.body + '</div>' +
        (f.act ? '<div class="f-act">建议动作：' + f.act + '</div>' : '') +
        '</div></div>';
    }).join('') : '<div class="empty">没有发现明显问题，保持即可。</div>';

    /* 结构条形 */
    const rows = m.byL1.slice(0, 10);
    const max = rows.length ? rows[0].amount : 1;
    U.$('#catBars').innerHTML = rows.length ? rows.map(function (r, i) {
      const w = r.amount / max * 100;
      return '<div class="bar-row"><span class="b-name" title="' + U.esc(r.name) + '">' + U.esc(r.name) + '</span>' +
        '<span class="b-track"><span class="b-fill" style="width:' + w + '%;background:' + CFG.PALETTE[i % CFG.PALETTE.length] + '"></span></span>' +
        '<span class="b-val"><b>' + U.money(r.amount, 0) + '</b> · ' + U.pct(m.totalConsume > 0 ? r.amount / m.totalConsume * 100 : 0) + '</span></div>';
    }).join('') : '<div class="empty">无数据</div>';

    /* Top 表 */
    const top = m.consumption.slice().sort(function (a, b) { return b.amount - a.amount; }).slice(0, 10);
    U.$('#topTable').innerHTML = top.map(function (e) {
      return '<tr><td>' + e.date + '</td><td>' + U.esc(e.category1 + '/' + e.category3) + '</td><td class="n">' + U.money(e.amount) + '</td><td class="n">' + U.pct(m.totalConsume > 0 ? e.amount / m.totalConsume * 100 : 0) + '</td></tr>';
    }).join('') || '<tr><td colspan="4" class="empty">无数据</td></tr>';

    /* 方案 */
    const P = Insights.plans(m);
    State.plans = P;
    const tabDefs = [
      { k: 'safe', t: '保守型', s: '省钱为主 · 目标储蓄率 20%' },
      { k: 'balanced', t: '平衡型', s: '可持续 · 目标储蓄率 15%' },
      { k: 'growth', t: '进取型', s: '一次投资，长远省钱' }
    ];
    U.$('#planTabs').innerHTML = tabDefs.map(function (d) {
      return '<button class="plan-tab' + (State.plan === d.k ? ' active' : '') + '" data-action="plan" data-plan="' + d.k + '">' + d.t + '<small>' + d.s + '</small></button>';
    }).join('');

    function planTable(p, extra) {
      const rowsHtml = p.rows.map(function (r) {
        return '<tr><td>' + r.name + '</td><td class="n">' + U.money(r.cur, 0) + '</td><td class="n">' + U.money(r.target, 0) + '</td><td class="n" style="color:var(--ok)">-' + U.money(r.save, 0) + '</td><td class="n">' + U.pct(r.ratio * 100, 0) + '</td></tr>';
      }).join('');
      const achievable = p.rate >= p.targetRate;
      return '<div class="tbl-scroll" style="margin-bottom:12px"><table class="tbl"><thead><tr><th>优化项</th><th class="n">现状/月</th><th class="n">目标/月</th><th class="n">月省</th><th class="n">削减幅度</th></tr></thead><tbody>' +
        rowsHtml + '</tbody><tfoot><tr><td>合计</td><td class="n">' + U.money(m.avgConsume, 0) + '</td><td class="n">' + U.money(p.newExpense, 0) + '</td><td class="n" style="color:var(--ok)">-' + U.money(p.save, 0) + '</td><td class="n">' + U.pct(m.avgConsume > 0 ? p.save / m.avgConsume * 100 : 0) + '</td></tr></tfoot></table></div>' +
        '<div class="metric-grid" style="margin-bottom:12px">' +
        '<div class="metric"><div class="m-lbl">优化后月支出</div><div class="m-val">' + U.money(p.newExpense, 0) + '</div><div class="m-note">原 ' + U.money(m.avgConsume, 0) + '</div></div>' +
        '<div class="metric"><div class="m-lbl">月结余</div><div class="m-val ' + (p.surplus >= 0 ? 'pos' : 'neg') + '">' + U.signMoney(p.surplus) + '</div><div class="m-note">月均收入 ' + U.money(p.inc, 0) + '</div></div>' +
        '<div class="metric"><div class="m-lbl">储蓄率</div><div class="m-val">' + U.pct(p.rate) + '</div><div class="m-note">目标 ' + p.targetRate + '%</div></div>' +
        '<div class="metric"><div class="m-lbl">年结余</div><div class="m-val">' + U.money(p.surplus * 12, 0) + '</div><div class="m-note">按 12 个月推演</div></div>' +
        '</div>' +
        (extra || '') +
        '<div class="callout ' + (achievable ? 'ok' : 'warn') + '" style="margin-top:12px">' +
        (achievable
          ? '<b>可达：</b>纯节流即可把储蓄率做到 ' + U.pct(p.rate) + '，超过 ' + p.targetRate + '% 的目标。建议达标后把结余的 70% 做定投、30% 留在应急金。'
          : '<b>仅靠节流不够：</b>极限压缩后储蓄率为 ' + U.pct(p.rate) + '，距 ' + p.targetRate + '% 还差 ' + U.money(Math.max(0, p.targetRate / 100 * p.inc - p.surplus), 0) + '/月。这部分必须靠开源（副业/涨薪/资产出租）补齐，或把目标降到 ' + U.pct(Math.max(0, p.rate), 0) + '。') +
        '</div>';
    }

    const investTable = '<div class="muted" style="font-weight:700;font-size:.82rem;margin:6px 0 8px">"一次投资、长远省钱"清单</div>' +
      '<div class="tbl-scroll" style="margin-bottom:12px"><table class="tbl"><thead><tr><th>投入项</th><th class="n">一次投入</th><th class="n">年省</th><th class="n">回收期</th><th>说明</th></tr></thead><tbody>' +
      P.invest.map(function (x) {
        const pay = x.cost > 0 ? (x.cost / (x.save / 12)).toFixed(1) + ' 个月' : '立即见效';
        return '<tr><td>' + x.name + '</td><td class="n">' + (x.cost ? U.money(x.cost, 0) : '—') + '</td><td class="n" style="color:var(--ok)">' + U.money(x.save, 0) + '</td><td class="n">' + pay + '</td><td class="muted-3" style="font-size:.74rem">' + x.note + '</td></tr>';
      }).join('') +
      '</tbody><tfoot><tr><td>合计</td><td class="n">' + U.money(P.investCost, 0) + '</td><td class="n" style="color:var(--ok)">' + U.money(P.investSave, 0) + '</td><td class="n">' + (P.investSave > 0 ? (P.investCost / (P.investSave / 12)).toFixed(1) + ' 个月' : '—') + '</td><td></td></tr></tfoot></table></div>';

    const sipDemo = Insights.sip(Math.max(500, Math.round(P.growth.surplus / 100) * 100), 6, 10);

    U.$('#planBodies').innerHTML =
      '<div class="plan-body' + (State.plan === 'safe' ? ' active' : '') + '">' + planTable(P.safe,
        '<div class="callout">保守型的执行顺序：<b>①</b> 先把外卖和零食这两项"无痛削减"做完（占可省金额的一半以上）；<b>②</b> 再动通信与住房这类固定成本（需要谈判或换租，周期 1-2 个月）；<b>③</b> 最后才是减少购物与娱乐。' +
        '顺序反了会让人很快放弃。</div>') + '</div>' +
      '<div class="plan-body' + (State.plan === 'balanced' ? ' active' : '') + '">' + planTable(P.balanced,
        '<div class="callout">平衡型保留生活品质：外卖仍可每周 2-3 次，娱乐与宠物预算基本不动，只压缩"无意识支出"。' +
        '适合长期坚持——可持续的方案永远优于最省的方案。</div>') + '</div>' +
      '<div class="plan-body' + (State.plan === 'growth' ? ' active' : '') + '">' + planTable(P.growth, investTable +
        '<div class="callout ok">进取型的逻辑：先花钱把"结构性成本"降下来，之后每年自动省 <b>' + U.money(P.investSave, 0) + '</b>，而投入只需要 <b>' + U.money(P.investCost, 0) + '</b> 且大多是一次性的。' +
        '把优化后的月结余（约 ' + U.money(Math.max(0, P.growth.surplus), 0) + '）按月定投，按年化 6% 测算，10 年约 <b>' + U.money(sipDemo.fv, 0) + '</b>（本金 ' + U.money(sipDemo.principal, 0) + '，收益 ' + U.money(sipDemo.gain, 0) + '）。</div>') + '</div>';

    /* 口径设置回填 */
    if (document.activeElement && document.activeElement.id === 'setTransfer') { /* 编辑中不覆盖 */ }
    else {
      U.$('#setTransfer').value = (Store.settings.transferKeys || []).join(', ');
      U.$('#setOneOff').value = (Store.settings.oneOffKeys || []).join(', ');
    }

    /* 数据质量 */
    const dq = [];
    dq.push({ ok: m.coverage >= 85, t: '记录覆盖率 ' + U.pct(m.coverage, 0) + '（' + m.days + '/' + m.spanDays + ' 天）', d: m.coverage >= 85 ? '覆盖良好，分析结论可信。' : '覆盖不足，个别结论可能被少数大额支出带偏。' });
    dq.push({ ok: m.monthGaps.length === 0, t: '收入记录完整度：缺 ' + m.monthGaps.length + ' 个月', d: m.monthGaps.length ? '缺失月份：' + m.monthGaps.join('、') + '；缺失会让储蓄率与结余全部失真。' : '范围内每个月都有收入记录。' });
    dq.push({ ok: m.totalTransfer === 0, t: '还款/转账类已单列（' + U.money(m.totalTransfer, 0) + '）', d: '若这些金额对应的消费已逐笔记账，务必保持"不计入消费"，否则支出会被重复统计。' });
    dq.push({ ok: true, t: '记录时间分布：' + m.firstDate + ' ~ ' + m.lastDate, d: '当天记 vs 事后补记会影响准确性，建议消费后立即记录。' });
    if (m.partialMonths && m.partialMonths.length) {
      dq.push({ ok: false, t: '边界月份记账不完整：' + m.partialMonths.join('、'),
        d: m.partialMonths.map(function (k) { return k + ' 仅 ' + m.daysPerMonth[k] + ' 天'; }).join('，') + '；这些月份会拉低月均，做趋势对比时应排除或补齐。' });
    }
    dq.push({ ok: m.earlyShare < 45, t: '月初 1-10 日支出占 ' + U.pct(m.earlyShare), d: m.earlyShare >= 45 ? '月初压力集中（房租/囤货），建议把固定扣款日错开到月中。' : '月内分布相对平滑。' });
    U.$('#dqList').innerHTML = dq.map(function (x) {
      return '<div class="finding sev-' + (x.ok ? 'good' : 'warn') + '" style="margin-bottom:8px"><div class="f-ico">' + (x.ok ? '✅' : '⚠️') + '</div><div><div class="f-title">' + x.t + '</div><div class="f-body">' + x.d + '</div></div></div>';
    }).join('');

    /* 同比 + 口径建议 + 规则面板（每次重算都刷新） */
    this.renderYoY();
    this.renderSuggest();
    this.renderRules();

    /* 测算器默认值：跟随"分析范围 + 数据本身"自动刷新，但不会被"切换方案标签"覆盖 */
    const calcSig = State.scope + '|' + m.nMonths + '|' + m.count + '|' + m.totalBook.toFixed(2) + '|' + m.totalIncome.toFixed(2);
    if (State.calcSig !== calcSig) {
      U.$('#calcRigid').value = Math.round(m.rigidMonthly);
      U.$('#calcMonthly').value = Math.max(0, Math.round(m.avgIncome - m.avgConsume));
      if (!U.$('#calcMonths').value) U.$('#calcMonths').value = RULES().emergency.months;
      State.calcSig = calcSig;
    }
    this.runCalcs();
  },

  runCalcs() {
    const m = State.meta || { rigidMonthly: 4500, avgIncome: 0, avgConsume: 0 };
    const rigid = Number(U.$('#calcRigid').value) || 0;
    const months = Number(U.$('#calcMonths').value) || 3;
    const save = Number(U.$('#calcMonthly').value) || 0;
    const target = rigid * months;
    const need = save > 0 ? Math.ceil(target / save) : Infinity;
    U.$('#calcOut1').innerHTML =
      '<div class="line"><span>目标应急金</span><b>' + U.money(target, 0) + '</b></div>' +
      '<div class="line"><span>每月可存</span><b>' + U.money(save, 0) + '</b></div>' +
      '<div class="line"><span>达成时间</span><b>' + (isFinite(need) ? need + ' 个月' : '当前无结余可存') + '</b></div>' +
      '<div class="line muted-3" style="font-size:.72rem">先放到货币基金/活期，随时可取，不追求收益。</div>';

    const amt = Number(U.$('#sipAmount').value) || 0;
    const rate = Number(U.$('#sipRate').value) || 0;
    const yrs = Number(U.$('#sipYears').value) || 1;
    const r = Insights.sip(amt, rate, yrs);
    U.$('#calcOut2').innerHTML =
      '<div class="line"><span>投入本金</span><b>' + U.money(r.principal, 0) + '</b></div>' +
      '<div class="line"><span>预计终值</span><b style="color:var(--ok)">' + U.money(r.fv, 0) + '</b></div>' +
      '<div class="line"><span>其中收益</span><b>' + U.money(r.gain, 0) + '</b></div>' +
      '<div class="line muted-3" style="font-size:.72rem">宽基指数长期年化按 5%~8% 假设；不要用杠杆，不要频繁择时。</div>';

    const goal = Number(U.$('#goalRate').value) || 0;
    const inc = m.avgIncome || 0;
    if (inc <= 0) {
      U.$('#calcOut3').innerHTML = '<div class="line muted-3">请先录入收入，才能计算目标储蓄率。</div>';
    } else {
      const needExpense = inc * (1 - goal / 100);
      const gap = m.avgConsume - needExpense;
      const P = State.plans || Insights.plans(m);
      const cutCapacity = P.safe.save;
      U.$('#calcOut3').innerHTML =
        '<div class="line"><span>目标月支出上限</span><b>' + U.money(needExpense, 0) + '</b></div>' +
        '<div class="line"><span>当前月均消费</span><b>' + U.money(m.avgConsume, 0) + '</b></div>' +
        '<div class="line"><span>需要压缩</span><b class="' + (gap > 0 ? 'neg' : 'pos') + '">' + U.money(Math.max(0, gap), 0) + '</b></div>' +
        '<div class="line"><span>节流可提供</span><b>' + U.money(cutCapacity, 0) + '</b></div>' +
        '<div class="line"><span>尚需开源</span><b style="color:' + (Math.max(0, gap - cutCapacity) > 0 ? 'var(--danger)' : 'var(--ok)') + '">' + U.money(Math.max(0, gap - cutCapacity), 0) + '/月</b></div>' +
        '<div class="line muted-3" style="font-size:.72rem">储蓄率每提高 5 个百分点 ≈ 每月多存 ' + U.money(inc * 0.05, 0) + ' ≈ 每年 ' + U.money(inc * 0.05 * 12, 0) + '。</div>';
    }
  },

  /* ---------- 预算 ---------- */
  renderBudget(m) {
    const ym = State.year + '-' + U.pad(State.month);
    const b = Store.budgets[ym] || { month: ym, total: 0, cats: {} };
    U.$('#budgetPeriodHint').textContent = U.monthLabel(ym);
    U.$('#budTotal').value = b.total || '';
    U.$('#budDefaultTotal').value = Store.settings.defaultBudgetTotal || '';
    const spent = U.sum(m.list);
    const totalBudget = b.total || 0;
    U.$('#budTotalBar').innerHTML = totalBudget > 0
      ? this.budBarHtml('本月总预算', spent, totalBudget, '')
      : '<div class="muted-3" style="font-size:.8rem">尚未设置总预算。参考值：把目标储蓄率反推的支出上限设为总预算。</div>';

    const cats = Object.keys(Store.categories);
    const spendByL1 = {};
    m.list.forEach(function (e) { spendByL1[e.category1] = (spendByL1[e.category1] || 0) + e.amount; });
    U.$('#budCatList').innerHTML = cats.map(function (c) {
      const val = (b.cats && b.cats[c]) || '';
      const sp = spendByL1[c] || 0;
      const bar = val > 0 ? this.budBarHtml(c, sp, val, c) : '';
      return '<div class="bud-row"><div><div class="bud-top"><b>' + U.esc(c) + '</b><span class="muted-3">已花 ' + U.money(sp, 0) + (val > 0 ? ' / 预算 ' + U.money(val, 0) : '') + '</span></div>' + bar + '</div>' +
        '<input type="number" step="50" data-budcat="' + U.esc(c) + '" value="' + (val || '') + '" placeholder="不限" style="padding:8px 10px;border:1px solid var(--border);border-radius:10px;background:var(--card-2)"></div>';
    }, this).join('');

    /* 建议 */
    const advice = [];
    if (totalBudget > 0) {
      const pctUsed = spent / totalBudget * 100;
      const dayOfMonth = new Date().getDate();
      const daysInM = U.daysInMonth(State.year, State.month);
      const pace = dayOfMonth / daysInM * 100;
      advice.push(pctUsed > 100
        ? { c: 'danger', t: '总预算已超支 ' + U.money(spent - totalBudget, 0), d: '需要立刻冻结弹性支出（外卖、零食、非必需购物），并检查是否有可推迟的一次性支出。' }
        : pctUsed > pace + 12
          ? { c: 'warn', t: '花得比时间快：已用 ' + U.pct(pctUsed, 0) + '，进度 ' + U.pct(pace, 0), d: '按当前速度月末会到 ' + U.money(spent / Math.max(1, dayOfMonth) * daysInM, 0) + '，超出预算 ' + U.money(Math.max(0, spent / Math.max(1, dayOfMonth) * daysInM - totalBudget), 0) + '。' }
          : { c: 'ok', t: '预算执行良好（已用 ' + U.pct(pctUsed, 0) + '）', d: '剩余 ' + U.money(Math.max(0, totalBudget - spent), 0) + '，日均可用 ' + U.money(Math.max(0, totalBudget - spent) / Math.max(1, daysInM - dayOfMonth + 1), 0) + '。' });
    } else {
      const rec = m.avgIncome > 0 ? m.avgIncome * 0.8 : m.avgConsume * 0.85;
      advice.push({ c: '', t: '建议先把总预算设为 ' + U.money(rec, 0), d: '按收入 8 折或历史消费 8.5 折起步，坚持两周后按实际调整，不要一次定太紧。' });
    }
    const over = Object.keys(spendByL1).filter(function (c) { return b.cats && b.cats[c] > 0 && spendByL1[c] > b.cats[c]; });
    if (over.length) advice.push({ c: 'warn', t: '超预算分类：' + over.join('、'), d: '优先从这些分类里找可替代方案，而不是平均削减所有分类。' });
    advice.push({ c: '', t: '给"大额准备金"单独建预算', d: '每月固定转入 ' + U.money(Math.max(300, (State.meta ? State.meta.totalOneOff / Math.max(1, State.meta.nMonths) : 1000)), 0) + '，用于机票、物业费、保险、家电维修等；支出时从该账户出，不再冲击生活预算。' });
    U.$('#budAdvice').innerHTML = advice.map(function (a) {
      return '<div class="callout ' + (a.c === 'danger' ? 'danger' : a.c === 'warn' ? 'warn' : a.c === 'ok' ? 'ok' : '') + '" style="margin-bottom:9px"><b>' + a.t + '</b><br>' + a.d + '</div>';
    }).join('');
  },

  budBarHtml(name, spent, budget, cat) {
    const pct = budget > 0 ? spent / budget * 100 : 0;
    const col = pct > 100 ? 'var(--danger)' : pct > 80 ? 'var(--warn)' : 'var(--ok)';
    const dayOfMonth = new Date().getDate();
    const daysInM = U.daysInMonth(State.year, State.month);
    const left = Math.max(0, budget - spent);
    return '<div class="bud-track"><div class="bud-fill" style="width:' + U.clamp(pct, 0, 100) + '%;background:' + col + '"></div></div>' +
      '<div class="bud-meta"><span>' + U.pct(pct, 0) + ' 已用</span><span>' + (left > 0 ? '剩余 ' + U.money(left, 0) + ' · 日均 ' + U.money(left / Math.max(1, daysInM - dayOfMonth + 1), 0) : '已超支') + '</span></div>';
  },

  /* ---------- 分类管理 ---------- */
  renderCatTree() {
    const box = U.$('#catTree');
    const cats = Store.categories;
    let html = '<ul class="cat-tree">';
    Object.keys(cats).forEach(function (c1) {
      html += '<li><div class="cat-node"><input type="text" value="' + U.esc(c1) + '" data-cat-rename="1" data-l1="' + U.esc(c1) + '">' +
        '<div class="acts">' +
        '<button class="btn btn-xs btn-outline" data-action="cat-move" data-l1="' + U.esc(c1) + '" data-dir="-1">▲</button>' +
        '<button class="btn btn-xs btn-outline" data-action="cat-move" data-l1="' + U.esc(c1) + '" data-dir="1">▼</button>' +
        '<button class="btn btn-xs btn-outline" data-action="cat-add-l2" data-l1="' + U.esc(c1) + '">+二级</button>' +
        '<button class="btn btn-xs btn-danger" data-action="cat-del-l1" data-l1="' + U.esc(c1) + '">删除</button>' +
        '</div></div>';
      const c2s = Object.keys(cats[c1] || {});
      if (c2s.length) {
        html += '<ul>';
        c2s.forEach(function (c2) {
          html += '<li><div class="cat-node"><input type="text" value="' + U.esc(c2) + '" data-cat-rename="2" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '">' +
            '<div class="acts">' +
            '<button class="btn btn-xs btn-outline" data-action="cat-move2" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-dir="-1">▲</button>' +
            '<button class="btn btn-xs btn-outline" data-action="cat-move2" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-dir="1">▼</button>' +
            '<button class="btn btn-xs btn-outline" data-action="cat-add-l3" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '">+三级</button>' +
            '<button class="btn btn-xs btn-danger" data-action="cat-del-l2" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '">删除</button>' +
            '</div></div>';
          const c3s = cats[c1][c2] || [];
          if (c3s.length) {
            html += '<ul>';
            c3s.forEach(function (c3) {
              html += '<li><div class="cat-node"><input type="text" value="' + U.esc(c3) + '" data-cat-rename="3" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-l3="' + U.esc(c3) + '">' +
                '<div class="acts">' +
                '<button class="btn btn-xs btn-outline" data-action="cat-move3" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-l3="' + U.esc(c3) + '" data-dir="-1">▲</button>' +
                '<button class="btn btn-xs btn-outline" data-action="cat-move3" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-l3="' + U.esc(c3) + '" data-dir="1">▼</button>' +
                '<button class="btn btn-xs btn-danger" data-action="cat-del-l3" data-l1="' + U.esc(c1) + '" data-l2="' + U.esc(c2) + '" data-l3="' + U.esc(c3) + '">删除</button>' +
                '</div></div></li>';
            });
            html += '</ul>';
          }
          html += '</li>';
        });
        html += '</ul>';
      }
      html += '</li>';
    });
    html += '</ul>';
    box.innerHTML = html;
  },

  /* ---------- 规则与阈值 ---------- */
  renderRules() {
    const box = U.$('#rulesBox');
    if (!box) return;
    const R = RULES();
    box.innerHTML = RULE_FIELDS.map(function (g) {
      return '<div class="rule-group"><div class="rule-g">' + g.g + '</div><div class="rule-grid">' +
        g.items.map(function (it) {
          const raw = U.getPath(R, it.p);
          const val = it.pct ? Math.round((Number(raw) || 0) * 100) : raw;
          return '<label class="rule-item"><span>' + it.l + '</span>' +
            '<input type="number" data-rule="' + it.p + '"' + (it.pct ? ' data-pct="1"' : '') +
            ' value="' + (val == null ? '' : val) + '"' +
            (it.min != null ? ' min="' + it.min + '"' : '') +
            (it.max != null ? ' max="' + it.max + '"' : '') +
            ' step="' + (it.step || 1) + '"></label>';
        }).join('') + '</div></div>';
    }).join('') +
      '<div class="muted-3" style="font-size:.73rem;margin-top:6px">当前规则包：<b>' + U.esc(R.name || '默认') + '</b></div>';
  },
  collectRules() {
    const out = JSON.parse(JSON.stringify(Store.settings.rules || {}));
    U.$$('[data-rule]').forEach(function (inp) {
      if (inp.value === '') { return; }
      let v = Number(inp.value);
      if (isNaN(v)) return;
      if (inp.dataset.pct) v = v / 100;
      U.setPath(out, inp.dataset.rule, v);
    });
    out.name = '自定义（' + new Date().toLocaleDateString('zh-CN') + '）';
    out.version = RULES_DEFAULT.version;
    return out;
  },
  applyRuleDefaults() {
    const R = RULES();
    U.$('#calcMonths').value = R.emergency.months;
    U.$('#sipAmount').value = R.sip.amount;
    U.$('#sipRate').value = R.sip.rate;
    U.$('#sipYears').value = R.sip.years;
    U.$('#goalRate').value = R.savings.good;
    State.calcSig = null;
    U.$('#rulesDetails').open = true;
  },
  async saveRules() {
    Store.settings.rules = this.collectRules();
    await Store.saveSettings();
    UI.renderAnalysis();
  },
  async resetRules() {
    Store.settings.rules = {};
    await Store.saveSettings();
    this.applyRuleDefaults();
    UI.renderAnalysis();
    UI.toast('已恢复内置默认规则');
  },
  exportRules() {
    U.download('记账规则包_' + U.todayISO() + '.json', JSON.stringify(RULES(), null, 2), 'application/json');
    UI.toast('规则包已导出（不含任何账目数据）');
  },
  importRules(file) {
    const fr = new FileReader();
    fr.onload = async function () {
      try {
        const j = JSON.parse(fr.result);
        if (!j || typeof j !== 'object') throw new Error('格式错误');
        Store.settings.rules = j;
        await Store.saveSettings();
        UI.applyRuleDefaults();
        UI.renderAnalysis();
        UI.toast('规则包已导入并生效');
      } catch (e) { UI.toast('规则文件不是有效的 JSON'); }
    };
    fr.readAsText(file);
  },
  async loadRulesFromFolder() {
    try {
      const res = await fetch('rules.json', { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const j = await res.json();
      Store.settings.rules = j;
      await Store.saveSettings();
      this.applyRuleDefaults();
      UI.renderAnalysis();
      UI.toast('已从同目录 rules.json 载入');
    } catch (e) {
      UI.toast('同目录加载失败：' + (e.message || e) + '（file:// 打开时浏览器会拦截，请改用「导入规则包」）');
    }
  },

  /* ---------- 待补录提醒 ---------- */
  renderNudge() {
    const box = U.$('#dataNudge');
    if (!box) return;
    if (State.nudgeOff) { box.innerHTML = ''; return; }
    const now = new Date();
    const ym = State.year + '-' + U.pad(State.month);
    const isCurrent = (now.getFullYear() === State.year && now.getMonth() + 1 === State.month);
    const expected = isCurrent ? now.getDate() : U.daysInMonth(State.year, State.month);
    const days = {};
    Store.expenses.forEach(function (e) { if (U.ymOf(e.date) === ym) days[e.date] = 1; });
    const cnt = Object.keys(days).length;
    const msgs = [];
    if (expected >= 6 && cnt > 0 && cnt / expected < 0.7) {
      msgs.push({ sev: 'warn', ico: '📝', t: U.monthLabel(ym) + ' 只记录了 ' + cnt + ' / ' + expected + ' 天',
        d: '数据不完整会把月均、占比与储蓄率全部拉低。补齐后再看分析，结论才准。' });
    }
    if (expected >= 8 && Store.incomeOf(ym) <= 0) {
      msgs.push({ sev: 'warn', ico: '💰', t: U.monthLabel(ym) + ' 还没有录入收入',
        d: '没有收入就无法计算储蓄率，所有与收入挂钩的指标都会失真。', month: ym, aLabel: '去录入' });
    }
    const pym = U.uidMonthShift(ym, -1);
    if (Store.incomeOf(pym) <= 0 && Store.expenses.some(function (e) { return U.ymOf(e.date) === pym; })) {
      msgs.push({ sev: 'warn', ico: '🗓️', t: U.monthLabel(pym) + ' 有支出但没有收入记录',
        d: '补齐后月度对比与同比才成立。', month: pym, aLabel: '去补录' });
    }
    if (!msgs.length) { box.innerHTML = ''; return; }
    box.innerHTML = msgs.map(function (x) {
      return '<div class="nudge sev-' + x.sev + '"><span class="n-ico">' + x.ico + '</span>' +
        '<div class="n-body"><b>' + x.t + '</b><span>' + x.d + '</span></div>' +
        (x.month ? '<button class="btn btn-outline btn-xs" data-action="nudge-income" data-month="' + x.month + '">' + x.aLabel + '</button>' : '') +
        '<button class="icon-btn" data-action="nudge-dismiss" title="本次不再提示" style="width:24px;height:24px;font-size:.75rem">✕</button></div>';
    }).join('');
  },

  /* ---------- 同比对比 ---------- */
  renderYoY() {
    const card = U.$('#yoyCard');
    if (!card) return;
    const cur = State.year, prev = cur - 1;
    card.style.display = 'block';
    U.$('#yoyHint').textContent = cur + ' 年 vs ' + prev + ' 年 · 修正口径（已剔除还款/转账）';
    const hasPrev = Store.expenses.some(function (e) { return e.date.slice(0, 4) === String(prev); });
    if (!hasPrev) {
      U.$('#yoyBody').innerHTML = '<div class="callout">本地还没有 ' + prev + ' 年的数据。' +
        '等你开始录入跨年数据后，这里会<b>自动</b>出现「按月同比」与「分类同比」，不需要任何额外设置或联网。</div>';
      return;
    }
    function consumeOf(year, month) {
      const ym = year + '-' + U.pad(month);
      return U.sum(Store.expenses.filter(function (e) { return U.ymOf(e.date) === ym && !Store.isTransfer(e); }));
    }
    let hc = 0, hp = 0;                 /* 各自全年累计 */
    let oc = 0, op = 0;                 /* 仅统计"两年都有数据"的同期可比月份 */
    const oMonths = [];
    const rows = [];
    for (let mm = 1; mm <= 12; mm++) {
      const a = consumeOf(cur, mm), b = consumeOf(prev, mm);
      if (a === 0 && b === 0) continue;
      hc += a; hp += b;
      if (a > 0 && b > 0) { oc += a; op += b; oMonths.push(mm); }
      const d = b > 0 ? (a - b) / b * 100 : null;
      rows.push('<tr><td>' + mm + ' 月</td><td class="n">' + U.money(a, 0) + '</td><td class="n">' + U.money(b, 0) +
        '</td><td class="n" style="color:' + (a > b ? 'var(--danger)' : 'var(--ok)') + '">' +
        (d === null ? (a > 0 ? '<span class="muted-3">去年无</span>' : '—') : (d >= 0 ? '+' : '') + U.pct(d, 0)) + '</td></tr>');
    }
    const cats = {};
    Store.expenses.forEach(function (e) {
      const y = Number(e.date.slice(0, 4));
      if (y !== cur && y !== prev) return;
      if (Store.isTransfer(e)) return;
      const k = e.category1;
      cats[k] = cats[k] || { c: 0, p: 0 };
      if (y === cur) cats[k].c += e.amount; else cats[k].p += e.amount;
    });
    const catRows = Object.keys(cats).map(function (k) { return { k: k, c: cats[k].c, p: cats[k].p }; })
      .sort(function (a, b) { return (b.c + b.p) - (a.c + a.p); }).slice(0, 10)
      .map(function (x) {
        const d = x.p > 0 ? (x.c - x.p) / x.p * 100 : null;
        return '<tr><td>' + U.esc(x.k) + '</td><td class="n">' + U.money(x.c, 0) + '</td><td class="n">' + U.money(x.p, 0) +
          '</td><td class="n" style="color:' + (x.c > x.p ? 'var(--danger)' : 'var(--ok)') + '">' +
          (d === null ? '新增' : (d >= 0 ? '+' : '') + U.pct(d, 0)) + '</td></tr>';
      }).join('');
    const dd = op > 0 ? (oc - op) / op * 100 : 0;
    const head = oMonths.length
      ? '同期可比月份（' + oMonths.join('、') + ' 月）：' + cur + ' 年 <b>' + U.money(oc, 0) + '</b>，' +
        prev + ' 年 <b>' + U.money(op, 0) + '</b>，' +
        (dd >= 0 ? '同比<b>上升 ' + U.pct(dd) + '</b>' : '同比<b>下降 ' + U.pct(Math.abs(dd)) + '</b>') + '。'
      : '两年暂时没有重叠的月份，无法做同期同比。';
    U.$('#yoyBody').innerHTML =
      '<div class="callout ' + (dd > 0 ? 'warn' : 'ok') + '" style="margin-bottom:12px">' + head +
      '<br><span class="muted-3" style="font-size:.75rem">各自累计：' + cur + ' 年 ' + U.money(hc, 0) +
      '（覆盖 ' + (rows.length) + ' 个月），' + prev + ' 年 ' + U.money(hp, 0) +
      '。跨年比较只看"同期可比月份"，否则月数不同会得出错误结论。</span></div>' +
      '<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">' +
      '<div><div class="muted" style="font-size:.78rem;font-weight:700;margin-bottom:8px">按月同比</div>' +
      '<div class="tbl-scroll" style="max-height:300px"><table class="tbl"><thead><tr><th>月份</th><th class="n">' + cur +
      '</th><th class="n">' + prev + '</th><th class="n">变化</th></tr></thead><tbody>' +
      (rows.join('') || '<tr><td colspan="4" class="empty">无数据</td></tr>') + '</tbody></table></div></div>' +
      '<div><div class="muted" style="font-size:.78rem;font-weight:700;margin-bottom:8px">分类同比</div>' +
      '<div class="tbl-scroll" style="max-height:300px"><table class="tbl"><thead><tr><th>分类</th><th class="n">' + cur +
      '</th><th class="n">' + prev + '</th><th class="n">变化</th></tr></thead><tbody>' +
      (catRows || '<tr><td colspan="4" class="empty">无数据</td></tr>') + '</tbody></table></div></div></div>';
  },

  /* ---------- 口径建议 ---------- */
  renderSuggest() {
    const box = U.$('#keySuggest');
    if (!box) return;
    const s = Insights.suggestKeys();
    const items = s.transfer.map(function (x) { x.kind = 'transfer'; return x; })
      .concat(s.oneOff.map(function (x) { x.kind = 'oneOff'; return x; }));
    if (!items.length) {
      box.innerHTML = '<div class="muted-3" style="font-size:.78rem">未发现需要登记的分类。新增了「车贷 / 学费 / 年费」这类科目后，再点一次扫描即可。</div>';
      return;
    }
    box.innerHTML = items.map(function (x) {
      return '<button class="chip ' + (x.kind === 'transfer' ? 'chip-info' : 'chip-warn') + '" data-action="add-key" data-kind="' +
        x.kind + '" data-key="' + U.esc(x.key) + '" title="累计 ' + U.money(x.amount, 0) + '（' + x.level + '级分类）">＋ ' +
        U.esc(x.key) + '</button>';
    }).join(' ');
  },

  /* ---------- 主渲染 ---------- */
  render() {
    const sc = Analytics.scope('current', { year: State.year, month: State.month });
    const mCur = Analytics.compute(State.view === 'year'
      ? Analytics.scope('year', { year: State.year, month: State.month })
      : sc);

    U.$('#periodLabel').textContent = this.periodLabel();
    U.$('#periodPill').style.display = '';
    this.fillCascade();
    this.renderNudge();
    this.renderKpis(mCur);
    this.renderChart(mCur);
    this.renderDetail(mCur);
    this.renderRecent();
    if (State.pane === 'analysis') this.renderAnalysis();
    if (State.pane === 'budget') this.renderBudget(mCur);
    document.querySelectorAll('.tab').forEach(function (t) { t.classList.toggle('active', t.dataset.pane === State.pane); });
    document.querySelectorAll('.mobile-bar button').forEach(function (t) { t.classList.toggle('active', t.dataset.pane === State.pane); });
  }
};

/* ==================================================================
   6. 应用层：事件与启动
   ================================================================== */
const App = {
  /* ---- 明细行“当前视图”数据 ---- */
  currentList() {
    const all = Store.expenses;
    if (State.view === 'year') return all.filter(function (e) { return e.date.slice(0, 4) === String(State.year); });
    const ym = State.year + '-' + U.pad(State.month);
    return all.filter(function (e) { return U.ymOf(e.date) === ym; });
  },

  /* ---- 录入 ---- */
  async addExpense() {
    const amt = parseFloat(U.$('#expAmount').value);
    const date = U.$('#expDate').value;
    const c1 = U.$('#catL1').value, c2 = U.$('#catL2').value, c3 = U.$('#catL3').value;
    const note = U.$('#expNote').value.trim();
    if (!amt || amt <= 0) return UI.toast('请输入有效金额');
    if (!date) return UI.toast('请选择日期');
    if (!c1 || !c2 || !c3) return UI.toast('请完整选择三级分类');
    const e = { id: U.uid('exp'), amount: U.round2(amt), date: date, category1: c1, category2: c2, category3: c3, note: note, timestamp: Date.now() };
    await Store.addExpense(e);
    U.$('#expAmount').value = ''; U.$('#expNote').value = '';
    U.$('#expAmount').focus();
    UI.toast('已记录 ' + U.money(e.amount) + ' · ' + c3);
    UI.render();
  },

  async search() {
    const kw = U.$('#searchKw').value.trim().toLowerCase();
    const box = U.$('#searchList');
    if (!kw) { box.innerHTML = '<div class="empty">输入关键词开始查找</div>'; return; }
    const res = Store.expenses.filter(function (e) {
      return (e.category1 + e.category2 + e.category3 + (e.note || '') + e.amount + e.date).toLowerCase().indexOf(kw) !== -1;
    }).sort(function (a, b) { return b.date.localeCompare(a.date); });
    if (!res.length) { box.innerHTML = '<div class="empty">没有匹配记录</div>'; return; }
    const total = U.sum(res);
    box.innerHTML = '<div class="muted" style="font-size:.79rem;padding:6px 10px">命中 <b>' + res.length + '</b> 条，合计 <b>' + U.money(total) + '</b></div>' +
      res.slice(0, 400).map(function (e) {
        return '<div class="rec"><span class="r-main"><span class="r-cat">' + e.date + ' · ' + U.esc(e.category1 + '/' + e.category2 + '/' + e.category3) + '</span>' +
          (e.note ? '<span class="r-note">' + U.esc(e.note) + '</span>' : '') + '</span>' +
          '<span class="r-amt' + (Store.isTransfer(e) ? ' is-transfer' : '') + '">-¥' + Number(e.amount).toFixed(2) + '</span>' +
          '<button class="icon-btn r-del" data-action="del-exp" data-id="' + e.id + '" title="删除">🗑</button></div>';
      }).join('');
  },

  /* ---- 期间导航 ---- */
  nav(dir) {
    if (State.view === 'year') { State.year += dir; }
    else {
      let m = State.month + dir, y = State.year;
      if (m > 12) { m = 1; y++; } if (m < 1) { m = 12; y--; }
      State.month = m; State.year = y;
    }
    UI.render();
  },

  /* ---- 主题 ---- */
  applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    Store.settings.theme = t;
    Store.saveSettings();
  },

  /* ---- 文件 ---- */
  async openFile() {
    if (!window.showOpenFilePicker) return UI.toast('当前浏览器不支持，请使用"导入 JSON"');
    try {
      const pick = await window.showOpenFilePicker({ types: [{ description: 'JSON 账本', accept: { 'application/json': ['.json'] } }] });
      const handle = pick[0];
      const file = await handle.getFile();
      const data = JSON.parse(await file.text());
      Store.fileHandle = handle;
      await Store.importPayload(data, { merge: false });
      UI.toast('已打开并载入本地账本');
      UI.render(); UI.closeDrawer();
    } catch (e) { if (e && e.name !== 'AbortError') UI.toast('打开失败：' + (e.message || e)); }
  },
  async saveFile() {
    if (!window.showSaveFilePicker) return this.exportJSON();
    try {
      const handle = await window.showSaveFilePicker({ suggestedName: '记账数据_' + U.todayISO() + '.json', types: [{ description: 'JSON', accept: { 'application/json': ['.json'] } }] });
      Store.fileHandle = handle;
      const w = await handle.createWritable();
      await w.write(JSON.stringify(Store.snapshot(), null, 2));
      await w.close();
      UI.toast('已保存，后续改动会自动同步');
      UI.closeDrawer();
    } catch (e) { if (e && e.name !== 'AbortError') UI.toast('保存失败：' + (e.message || e)); }
  },
  exportJSON() { U.download('记账备份_' + U.todayISO() + '.json', JSON.stringify(Store.snapshot(), null, 2), 'application/json'); UI.toast('JSON 已导出'); UI.closeDrawer(); },
  exportExcel() {
    if (typeof XLSX === 'undefined') return UI.toast('Excel 组件未加载（需要联网）');
    const m = State.meta || Analytics.compute(Analytics.scope(State.scope, { year: State.year, month: State.month }));
    const list = (m.list || Store.expenses).slice().sort(function (a, b) { return a.date.localeCompare(b.date); });
    if (!list.length) return UI.toast('没有数据可导出');
    const rows = [['日期', '金额', '一级分类', '二级分类', '三级分类', '备注', '口径']];
    list.forEach(function (e) {
      rows.push([e.date, e.amount, e.category1, e.category2, e.category3, e.note || '', Store.isTransfer(e) ? '转账/还款' : (Store.isOneOff(e) ? '一次性' : '消费')]);
    });
    rows.push([]);
    rows.push(['汇总', '', '', '', '', '', '']);
    rows.push(['账面支出', m.totalBook.toFixed(2)]);
    rows.push(['修正消费（剔除转账/还款）', m.totalConsume.toFixed(2)]);
    rows.push(['一次性大额', m.totalOneOff.toFixed(2)]);
    rows.push(['常态消费', m.totalCore.toFixed(2)]);
    rows.push(['月均收入', m.avgIncome.toFixed(2)]);
    rows.push(['修正储蓄率', m.rateConsume.toFixed(2) + '%']);
    const ws = XLSX.utils.aoa_to_sheet(rows);
    ws['!cols'] = [{ wch: 12 }, { wch: 10 }, { wch: 12 }, { wch: 12 }, { wch: 14 }, { wch: 20 }, { wch: 12 }];
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, '支出明细');
    const byL1 = [['一级分类', '金额', '占比%', '笔数']].concat(m.byL1.map(function (r) { return [r.name, r.amount.toFixed(2), (m.totalConsume > 0 ? r.amount / m.totalConsume * 100 : 0).toFixed(2), r.count]; }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(byL1), '分类汇总');
    const months = Object.keys(m.byMonth).sort().map(function (k) { return [k, m.byMonth[k].income.toFixed(2), m.byMonth[k].book.toFixed(2), (m.byMonth[k].income - m.byMonth[k].book).toFixed(2), m.byMonth[k].count]; });
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([['月份', '收入', '账面支出', '结余', '笔数']].concat(months)), '月度收支');
    XLSX.writeFile(wb, '花销导出_' + U.todayISO() + '.xlsx');
    UI.toast('Excel 已导出'); UI.closeDrawer();
  },
  async importExcel(file) {
    if (typeof XLSX === 'undefined') return UI.toast('Excel 组件未加载（需要联网）');
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type: 'array' });
      const sheet = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '' });
      if (rows.length < 2) return UI.toast('至少需要标题行与一行数据');
      const header = rows[0].map(function (h) { return String(h).trim().toLowerCase().replace(/\s+/g, ''); });
      const iDate = header.findIndex(function (h) { return h.indexOf('日期') !== -1 || h === 'date'; });
      const iAmt = header.findIndex(function (h) { return h.indexOf('金额') !== -1 || h === 'amount'; });
      if (iDate === -1 || iAmt === -1) return UI.toast('缺少"日期"或"金额"列');
      const i1 = header.findIndex(function (h) { return h.indexOf('一级') !== -1; });
      const i2 = header.findIndex(function (h) { return h.indexOf('二级') !== -1; });
      const i3 = header.findIndex(function (h) { return h.indexOf('三级') !== -1; });
      const iNote = header.findIndex(function (h) { return h.indexOf('备注') !== -1 || h === 'note'; });
      const out = [];
      for (let i = 1; i < rows.length; i++) {
        const r = rows[i];
        const ds = this.formatDate(r[iDate]);
        const amt = parseFloat(String(r[iAmt]).replace(/[^\d.\-]/g, ''));
        if (!ds || !amt || amt <= 0) continue;
        const c1 = (i1 !== -1 ? String(r[i1]).trim() : '') || '其他';
        const c2 = (i2 !== -1 ? String(r[i2]).trim() : '') || '其他';
        const c3 = (i3 !== -1 ? String(r[i3]).trim() : '') || '默认';
        out.push({ id: U.uid('exp'), amount: U.round2(amt), date: ds, category1: c1, category2: c2, category3: c3, note: iNote !== -1 ? String(r[iNote]).trim() : '', timestamp: Date.now() + i });
      }
      if (!out.length) return UI.toast('没有解析到有效记录');
      await Store.importPayload({ expenses: out, categories: Store.categories }, { merge: true });
      UI.toast('导入 ' + out.length + ' 条记录'); UI.render(); UI.closeDrawer();
    } catch (e) { UI.toast('Excel 解析失败'); }
  },
  formatDate(raw) {
    if (raw instanceof Date) { return raw.getFullYear() + '-' + U.pad(raw.getMonth() + 1) + '-' + U.pad(raw.getDate()); }
    const s = String(raw).trim();
    if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
    if (/^\d{4}\/\d{1,2}\/\d{1,2}$/.test(s)) { const p = s.split('/'); return p[0] + '-' + U.pad(p[1]) + '-' + U.pad(p[2]); }
    const mm = s.match(/(\d{4})年(\d{1,2})月(\d{1,2})日/);
    if (mm) return mm[1] + '-' + U.pad(mm[2]) + '-' + U.pad(mm[3]);
    const n = Number(s);
    if (!isNaN(n) && n > 20000 && n < 90000) { const d = new Date(Math.round((n - 25569) * 86400000)); return d.getUTCFullYear() + '-' + U.pad(d.getUTCMonth() + 1) + '-' + U.pad(d.getUTCDate()); }
    return null;
  },
  exportReport() {
    const m = State.meta || Analytics.compute(Analytics.scope(State.scope, { year: State.year, month: State.month }));
    const s = Insights.score(m), v = Insights.verdict(s.total), f = Insights.findings(m), P = Insights.plans(m);
    const L = [];
    L.push('# 花销分析与理财建议报告');
    L.push('');
    L.push('- 生成时间：' + new Date().toLocaleString('zh-CN'));
    L.push('- 分析范围：' + m.scopeLabel + '（' + m.nMonths + ' 个月，' + m.count + ' 条记录，' + m.firstDate + ' ~ ' + m.lastDate + '）');
    L.push('- 健康评分：**' + s.total + '/100** —— ' + v.text);
    L.push('');
    L.push('## 一、核心结论');
    L.push('');
    L.push('| 指标 | 数值 |');
    L.push('| --- | --- |');
    L.push('| 月均收入 | ' + (m.avgIncome > 0 ? U.money(m.avgIncome) : '未录入') + ' |');
    L.push('| 月均支出（账面） | ' + U.money(m.avgBook) + ' |');
    L.push('| 月均修正消费 | ' + U.money(m.avgConsume) + ' |');
    L.push('| 月均结余（修正） | ' + (m.avgIncome > 0 ? U.signMoney(m.avgIncome - m.avgConsume) : '—') + ' |');
    L.push('| 修正储蓄率 | ' + (m.avgIncome > 0 ? U.pct(m.rateConsume) : '—') + ' |');
    L.push('| 固定成本占收入 | ' + (m.avgIncome > 0 ? U.pct(m.fixedRatio) : '—') + ' |');
    L.push('| 刚性月支出 | ' + U.money(m.rigidMonthly) + ' |');
    L.push('| 弹性可压缩空间 | ' + U.money(Math.max(0, m.avgConsume - m.rigidMonthly)) + ' |');
    L.push('| 恩格尔系数（修正） | ' + U.pct(m.engel) + ' |');
    L.push('| 外卖占餐饮 | ' + U.pct(m.deliveryShare) + ' |');
    L.push('| 小额高频（<¥15）占比 | ' + U.pct(m.smallShare, 0) + ' |');
    L.push('');
    L.push('## 二、评分明细');
    L.push('');
    s.dims.forEach(function (d) { L.push('- **' + d.key + '**：' + d.v + '/100 —— ' + d.note); });
    L.push('');
    L.push('## 三、自动诊断');
    L.push('');
    f.forEach(function (x, i) {
      L.push('### ' + (i + 1) + '. [' + x.sev + '] ' + x.title);
      L.push('');
      L.push(x.body);
      if (x.act) { L.push(''); L.push('> 建议动作：' + x.act.replace(/<[^>]+>/g, '')); }
      L.push('');
    });
    L.push('## 四、支出结构');
    L.push('');
    L.push('| 一级分类 | 金额 | 占比 | 笔数 |');
    L.push('| --- | ---: | ---: | ---: |');
    m.byL1.forEach(function (r) { L.push('| ' + r.name + ' | ' + U.money(r.amount) + ' | ' + U.pct(m.totalConsume > 0 ? r.amount / m.totalConsume * 100 : 0) + ' | ' + r.count + ' |'); });
    L.push('');
    L.push('## 五、三档方案');
    L.push('');
    [['保守型（省钱为主）', P.safe], ['平衡型（可持续）', P.balanced], ['进取型（一次投资，长远省钱）', P.growth]].forEach(function (pair) {
      const name = pair[0], p = pair[1];
      L.push('### ' + name + ' —— 目标储蓄率 ' + p.targetRate + '%');
      L.push('');
      L.push('| 优化项 | 现状/月 | 目标/月 | 月省 |');
      L.push('| --- | ---: | ---: | ---: |');
      p.rows.forEach(function (r) { L.push('| ' + r.name + ' | ' + U.money(r.cur, 0) + ' | ' + U.money(r.target, 0) + ' | ' + U.money(r.save, 0) + ' |'); });
      L.push('| **合计** | ' + U.money(m.avgConsume, 0) + ' | ' + U.money(p.newExpense, 0) + ' | **' + U.money(p.save, 0) + '** |');
      L.push('');
      L.push('- 优化后月支出：' + U.money(p.newExpense, 0) + '，月结余：' + U.signMoney(p.surplus) + '，储蓄率：' + U.pct(p.rate) + '，年结余：' + U.money(p.surplus * 12, 0));
      L.push('- ' + (p.rate >= p.targetRate ? '纯节流即可达标。' : '纯节流不足，缺口 ' + U.money(Math.max(0, p.targetRate / 100 * p.inc - p.surplus), 0) + '/月，需要开源补齐。'));
      L.push('');
    });
    L.push('### 进取型 · 一次性投入清单');
    L.push('');
    L.push('| 投入项 | 一次投入 | 年省 | 说明 |');
    L.push('| --- | ---: | ---: | --- |');
    P.invest.forEach(function (x) { L.push('| ' + x.name + ' | ' + (x.cost ? U.money(x.cost, 0) : '—') + ' | ' + U.money(x.save, 0) + ' | ' + x.note + ' |'); });
    L.push('| **合计** | ' + U.money(P.investCost, 0) + ' | **' + U.money(P.investSave, 0) + '** | 综合回收期 ' + (P.investSave > 0 ? (P.investCost / (P.investSave / 12)).toFixed(1) + ' 个月' : '—') + ' |');
    L.push('');
    const sip = Insights.sip(Math.max(500, Math.round(P.growth.surplus / 100) * 100), 6, 10);
    L.push('### 定投测算（月投 ' + U.money(Math.max(500, Math.round(P.growth.surplus / 100) * 100), 0) + '，年化 6%，10 年）');
    L.push('');
    L.push('本金 ' + U.money(sip.principal, 0) + '，预计终值 ' + U.money(sip.fv, 0) + '，收益 ' + U.money(sip.gain, 0) + '。');
    L.push('');
    L.push('## 六、执行清单（按优先级）');
    L.push('');
    L.push('1. 本周内：清理用不上的订阅，把通信套餐降档，给"大额准备金"开一个子账户。');
    L.push('2. 本月内：外卖自炊替代 40%，零食/便利店设月度上限，逐笔确认还款类不被重复计入消费。');
    L.push('3. 季度内：房租/物业议价或换租，停车费议价，机票错峰并提前 3-4 周购买。');
    L.push('4. 半年内：攒够 3 个月刚性支出作为应急金（' + U.money(m.rigidMonthly * 3, 0) + '），配齐百万医疗 + 意外 + 定期寿险。');
    L.push('5. 应急金达成后：把月结余的 70% 定投宽基指数，30% 留在货币基金。严禁信用卡分期、消费贷与杠杆。');
    L.push('');
    L.push('---');
    L.push('');
    L.push('*本报告由「花销记账本 · 智能分析版」基于本地记账数据自动生成，所有金额与比率均可回溯到原始记录。*');
    U.download('花销分析与理财建议_' + U.todayISO() + '.md', L.join('\n'), 'text/markdown');
    UI.toast('分析报告已导出'); UI.closeDrawer();
  },
  async wipe() {
    UI.confirm('清空全部数据', '将删除本机 IndexedDB 中的<b>全部支出、收入、预算与口径设置</b>。该操作不可恢复，建议先导出备份。', async function () {
      await DB.clear('expenses'); await DB.clear('monthlyIncome'); await DB.clear('budgets');
      Store.expenses = []; Store.incomes = {}; Store.budgets = {};
      await Store.sync(); UI.render(); UI.toast('已清空');
    });
  },

  /* ---- 抽屉 / 弹窗 ---- */
  openDrawer() { U.$('#drawer').classList.add('open'); U.$('#drawerOverlay').classList.add('open'); },
  closeDrawer() { U.$('#drawer').classList.remove('open'); U.$('#drawerOverlay').classList.remove('open'); },
  openCats() { UI.renderCatTree(); U.$('#catModal').classList.add('open'); UI.closeDrawer(); },
  closeCats() { U.$('#catModal').classList.remove('open'); UI.render(); },

  /* ---- 分类操作 ---- */
  async renameCat(level, l1, l2, l3, val) {
    const nv = String(val || '').trim();
    if (!nv) return UI.renderCatTree();
    if (level === 1) {
      if (nv === l1) return; if (Store.categories[nv]) return UI.toast('该名称已存在');
      const nc = {};
      Object.keys(Store.categories).forEach(function (k) { nc[k === l1 ? nv : k] = Store.categories[k]; });
      Store.categories = nc;
      Store.expenses.forEach(function (e) { if (e.category1 === l1) e.category1 = nv; });
    } else if (level === 2) {
      if (nv === l2) return; if (!Store.categories[l1] || Store.categories[l1][nv]) return UI.toast('该名称已存在');
      const no = {};
      Object.keys(Store.categories[l1]).forEach(function (k) { no[k === l2 ? nv : k] = Store.categories[l1][k]; });
      Store.categories[l1] = no;
      Store.expenses.forEach(function (e) { if (e.category1 === l1 && e.category2 === l2) e.category2 = nv; });
    } else {
      if (nv === l3) return;
      const arr = Store.categories[l1][l2];
      if (arr.indexOf(nv) !== -1) return UI.toast('该名称已存在');
      arr[arr.indexOf(l3)] = nv;
      Store.expenses.forEach(function (e) { if (e.category1 === l1 && e.category2 === l2 && e.category3 === l3) e.category3 = nv; });
    }
    await Promise.all([Store.saveCategories(), DB.putMany('expenses', Store.expenses)]);
    UI.renderCatTree(); UI.render(); UI.toast('分类已重命名');
  },
  moveCat(level, l1, l2, l3, dir) {
    function swapKeys(obj, key, dir) {
      const keys = Object.keys(obj); const i = keys.indexOf(key);
      const j = i + dir; if (i < 0 || j < 0 || j >= keys.length) return false;
      const nk = keys.slice(); const t = nk[i]; nk[i] = nk[j]; nk[j] = t;
      const no = {}; nk.forEach(function (k) { no[k] = obj[k]; });
      Object.keys(obj).forEach(function (k) { delete obj[k]; });
      nk.forEach(function (k) { obj[k] = no[k]; });
      return true;
    }
    let changed = false;
    if (level === 1) changed = swapKeys(Store.categories, l1, dir);
    else if (level === 2) changed = swapKeys(Store.categories[l1], l2, dir);
    else if (level === 3) {
      const arr = Store.categories[l1][l2]; const i = arr.indexOf(l3); const j = i + dir;
      if (i >= 0 && j >= 0 && j < arr.length) { const t = arr[i]; arr[i] = arr[j]; arr[j] = t; changed = true; }
    }
    if (changed) Store.saveCategories().then(function () { UI.renderCatTree(); UI.render(); });
  },
  delCat(level, l1, l2, l3) {
    const label = level === 1 ? l1 : level === 2 ? l2 : l3;
    const childCount = level === 1 ? Object.keys(Store.categories[l1] || {}).length
      : level === 2 ? ((Store.categories[l1] || {})[l2] || []).length : 0;
    const usedCount = Store.expenses.filter(function (e) {
      return e.category1 === l1 && (level === 1 || e.category2 === l2) && (level !== 3 || e.category3 === l3);
    }).length;
    UI.confirm('删除分类「' + label + '」',
      '该分类' + (childCount ? '含 ' + childCount + ' 个下级分类，' : '') + '已被 <b>' + usedCount + '</b> 条记录使用。<br>删除分类不会删除历史记录，但这些记录的分类名会保留原样。',
      async function () {
        if (level === 1) delete Store.categories[l1];
        else if (level === 2) { delete Store.categories[l1][l2]; if (!Object.keys(Store.categories[l1]).length) delete Store.categories[l1]; }
        else { Store.categories[l1][l2] = Store.categories[l1][l2].filter(function (x) { return x !== l3; }); if (!Store.categories[l1][l2].length) delete Store.categories[l1][l2]; if (!Object.keys(Store.categories[l1]).length) delete Store.categories[l1]; }
        await Store.saveCategories(); UI.renderCatTree(); UI.render(); UI.toast('已删除分类');
      });
  },
  quickCat(level) {
    State.quickLevel = level;
    const titles = { 1: '新增一级分类', 2: '新增二级分类', 3: '新增三级分类' };
    U.$('#quickTitle').textContent = titles[level];
    U.$('#quickLabel').textContent = '名称';
    U.$('#quickInput').value = '';
    const wrap = U.$('#quickParentWrap'), sel = U.$('#quickParent');
    if (level === 1) { wrap.style.display = 'none'; sel.disabled = false; }
    else if (level === 2) {
      wrap.style.display = 'block'; sel.disabled = false;
      sel.innerHTML = Object.keys(Store.categories).map(function (k) { return '<option>' + U.esc(k) + '</option>'; }).join('');
      if (U.$('#catL1').value) sel.value = U.$('#catL1').value;
    } else {
      const c1 = U.$('#catL1').value, c2 = U.$('#catL2').value;
      if (!c1 || !c2) return UI.toast('请先选择一级与二级分类');
      wrap.style.display = 'block'; sel.disabled = true;
      sel.innerHTML = '<option>' + U.esc(c1 + ' / ' + c2) + '</option>';
      sel.dataset.pair = c1 + '\u0001' + c2;
    }
    U.$('#quickModal').classList.add('open');
    setTimeout(function () { U.$('#quickInput').focus(); }, 60);
  },
  async quickOk() {
    const name = U.$('#quickInput').value.trim();
    if (!name) return UI.toast('请输入名称');
    const lv = State.quickLevel;
    if (lv === 1) {
      if (Store.categories[name]) return UI.toast('已存在');
      Store.categories[name] = { '其他': ['默认'] };
    } else if (lv === 2) {
      const p = U.$('#quickParent').value;
      if (!Store.categories[p]) Store.categories[p] = {};
      if (Store.categories[p][name]) return UI.toast('已存在');
      Store.categories[p][name] = ['默认'];
    } else {
      const pair = (U.$('#quickParent').dataset.pair || '').split('\u0001');
      const c1 = pair[0], c2 = pair[1];
      if (!Store.categories[c1] || !Store.categories[c1][c2]) return UI.toast('上级分类不存在');
      if (Store.categories[c1][c2].indexOf(name) !== -1) return UI.toast('已存在');
      Store.categories[c1][c2].push(name);
    }
    await Store.saveCategories();
    U.$('#quickModal').classList.remove('open');
    UI.fillCascade(); UI.toast('已新增分类');
    setTimeout(function () {
      if (lv === 1) { U.$('#catL1').value = name; U.$('#catL1').dispatchEvent(new Event('change')); }
      else if (lv === 2) { U.$('#catL2').value = name; U.$('#catL2').dispatchEvent(new Event('change')); }
      else { U.$('#catL3').value = name; }
    }, 40);
  },
  async addCat1() {
    const name = U.$('#newCat1').value.trim();
    if (!name) return;
    if (Store.categories[name]) return UI.toast('已存在');
    Store.categories[name] = { '其他': ['默认'] };
    await Store.saveCategories();
    U.$('#newCat1').value = '';
    UI.renderCatTree(); UI.render(); UI.toast('已新增一级分类');
  },

  /* ---- 预算 ---- */
  async saveBudget() {
    const ym = State.year + '-' + U.pad(State.month);
    const total = Number(U.$('#budTotal').value) || 0;
    const cats = {};
    U.$$('[data-budcat]').forEach(function (inp) { const v = Number(inp.value) || 0; if (v > 0) cats[inp.dataset.budcat] = v; });
    await Store.setBudget(ym, { month: ym, total: total, cats: cats });
    const def = Number(U.$('#budDefaultTotal').value) || 0;
    Store.settings.defaultBudgetTotal = def;
    await Store.saveSettings();
    UI.renderBudget(State.meta || Analytics.compute(Analytics.scope('current', { year: State.year, month: State.month })));
    UI.toast('预算已保存');
  },
  async budClear() {
    const ym = State.year + '-' + U.pad(State.month);
    await Store.delBudget(ym); UI.render(); UI.toast('已清空本月预算');
  },

  /* ---- 载入内置数据 ---- */
  async loadDemo() {
    if (!window.EMBEDDED) return UI.toast('内置数据不可用');
    UI.confirm('载入内置参考账本', '将把 ' + window.EMBEDDED.expenses.length + ' 条参考记录<b>合并</b>到当前账本（不会删除已有数据）。载入后可在「数据分析与建议」里直接看到完整分析结果。', async function () {
      await Store.importPayload({ expenses: window.EMBEDDED.expenses, categories: window.EMBEDDED.categories, monthlyIncomes: window.EMBEDDED.monthlyIncomes }, { merge: true });
      UI.toast('已载入 ' + window.EMBEDDED.expenses.length + ' 条参考记录');
      UI.render(); UI.closeDrawer();
    });
  }
};

/* ==================================================================
   7. 事件绑定（统一委托，替代大量内联 onclick）
   ================================================================== */
function bind() {
  document.addEventListener('click', function (ev) {
    const el = ev.target.closest('[data-action]');
    if (!el) return;
    const a = el.dataset.action;
    const h = {
      'pane': function () { State.pane = el.dataset.pane; U.$$('.pane').forEach(function (p) { p.classList.toggle('active', p.id === 'pane-' + State.pane); }); U.$$('.tab').forEach(function (t) { t.classList.toggle('active', t.dataset.pane === State.pane); }); U.$$('.mobile-bar button').forEach(function (t) { t.classList.toggle('active', t.dataset.pane === State.pane); }); UI.render(); window.scrollTo({ top: 0, behavior: 'smooth' }); },
      'view': function () { State.view = el.dataset.view; U.$$('[data-action="view"]').forEach(function (b) { b.classList.toggle('active', b === el); }); UI.render(); },
      'chart': function () { State.chart = el.dataset.chart; U.$$('[data-action="chart"]').forEach(function (b) { b.classList.toggle('active', b === el); }); UI.renderChart(State.meta || Analytics.compute(Analytics.scope('current', { year: State.year, month: State.month }))); },
      'nav-prev': function () { App.nav(-1); },
      'nav-next': function () { App.nav(1); },
      'nav-today': function () { const d = new Date(); State.year = d.getFullYear(); State.month = d.getMonth() + 1; UI.render(); },
      'toggle-theme': function () { App.applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'); UI.renderChart(State.meta || Analytics.compute(Analytics.scope('current', { year: State.year, month: State.month }))); },
      'add-expense': function () { App.addExpense(); },
      'save-income': function () {
        const mo = U.$('#incMonth').value, v = parseFloat(U.$('#incAmount').value);
        if (!mo) return UI.toast('请选择月份');
        if (isNaN(v) || v < 0) return UI.toast('请输入有效金额');
        Store.setIncome(mo, U.round2(v)).then(function () { UI.toast('已保存 ' + mo + ' 收入 ' + U.money(v)); UI.render(); });
      },
      'load-income': function () {
        const ym = State.year + '-' + U.pad(State.month);
        U.$('#incMonth').value = ym; U.$('#incAmount').value = Store.incomeOf(ym) || '';
      },
      'search': function () { App.search(); },
      'search-clear': function () { U.$('#searchKw').value = ''; U.$('#searchList').innerHTML = '<div class="empty">输入关键词开始查找</div>'; },
      'del-exp': function () {
        const id = el.dataset.id;
        const rec = Store.expenses.filter(function (x) { return x.id === id; })[0];
        UI.confirm('删除这条记录？', rec ? (rec.date + ' · ' + U.esc(rec.category1 + '/' + rec.category2 + '/' + rec.category3) + ' · <b>' + U.money(rec.amount) + '</b><br>删除后不可恢复。') : '', async function () {
          await Store.removeExpense(id); UI.render(); App.search(); UI.toast('已删除');
        });
      },
      'open-drawer': function () { App.openDrawer(); },
      'close-drawer': function () { App.closeDrawer(); },
      'open-file': function () { App.openFile(); },
      'save-file': function () { App.saveFile(); },
      'export-json': function () { App.exportJSON(); },
      'import-json': function () { U.$('#jsonInput').click(); },
      'import-excel': function () { U.$('#excelInput').click(); },
      'export-excel': function () { App.exportExcel(); },
      'export-report': function () { App.exportReport(); },
      'open-cats': function () { App.openCats(); },
      'close-cats': function () { App.closeCats(); },
      'load-demo': function () { App.loadDemo(); },
      'wipe': function () { App.wipe(); },
      'add-cat1': function () { App.addCat1(); },
      'cat-move': function () { App.moveCat(1, el.dataset.l1, null, null, Number(el.dataset.dir)); },
      'cat-move2': function () { App.moveCat(2, el.dataset.l1, el.dataset.l2, null, Number(el.dataset.dir)); },
      'cat-move3': function () { App.moveCat(3, el.dataset.l1, el.dataset.l2, el.dataset.l3, Number(el.dataset.dir)); },
      'cat-del-l1': function () { App.delCat(1, el.dataset.l1); },
      'cat-del-l2': function () { App.delCat(2, el.dataset.l1, el.dataset.l2); },
      'cat-del-l3': function () { App.delCat(3, el.dataset.l1, el.dataset.l2, el.dataset.l3); },
      'cat-add-l2': function () {
        const n = prompt('请输入新的二级分类名称');
        if (!n || !n.trim()) return;
        if (!Store.categories[el.dataset.l1]) Store.categories[el.dataset.l1] = {};
        if (Store.categories[el.dataset.l1][n.trim()]) return UI.toast('已存在');
        Store.categories[el.dataset.l1][n.trim()] = ['默认'];
        Store.saveCategories().then(function () { UI.renderCatTree(); UI.render(); });
      },
      'cat-add-l3': function () {
        const n = prompt('请输入新的三级分类名称');
        if (!n || !n.trim()) return;
        const c1 = el.dataset.l1, c2 = el.dataset.l2;
        if (!Store.categories[c1] || !Store.categories[c1][c2]) return;
        if (Store.categories[c1][c2].indexOf(n.trim()) !== -1) return UI.toast('已存在');
        Store.categories[c1][c2].push(n.trim());
        Store.saveCategories().then(function () { UI.renderCatTree(); UI.render(); });
      },
      'quick-cat': function () { App.quickCat(Number(el.dataset.level)); },
      'quick-close': function () { U.$('#quickModal').classList.remove('open'); },
      'quick-ok': function () { App.quickOk(); },
      'confirm-no': function () { UI.closeConfirm(); },
      'confirm-yes': function () { const cb = State.confirmCb; UI.closeConfirm(); if (cb) cb(); },
      'plan': function () { State.plan = el.dataset.plan; UI.renderAnalysis(); },
      'save-settings': function () {
        Store.settings.transferKeys = U.parseList(U.$('#setTransfer').value);
        Store.settings.oneOffKeys = U.parseList(U.$('#setOneOff').value);
        Store.saveSettings().then(function () { UI.toast('口径已保存'); UI.render(); });
      },
      'nudge-income': function () {
        const mo = el.dataset.month;
        U.$('#incMonth').value = mo;
        U.$('#incAmount').value = Store.incomeOf(mo) || '';
        U.$('#incAmount').focus();
        UI.toast('请填写 ' + mo + ' 的到手收入后点「保存收入」');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      },
      'nudge-dismiss': function () { State.nudgeOff = true; U.$('#dataNudge').innerHTML = ''; },
      'scan-keys': function () { UI.renderSuggest(); UI.toast('已重新扫描全部分类'); },
      'add-key': function () {
        const kind = el.dataset.kind, key = el.dataset.key;
        const field = kind === 'transfer' ? 'transferKeys' : 'oneOffKeys';
        const arr = (Store.settings[field] || []).slice();
        if (arr.indexOf(key) === -1) arr.push(key);
        Store.settings[field] = arr;
        Store.saveSettings().then(function () {
          U.$('#setTransfer').value = (Store.settings.transferKeys || []).join(', ');
          U.$('#setOneOff').value = (Store.settings.oneOffKeys || []).join(', ');
          UI.renderAnalysis();
          UI.toast('已加入' + (kind === 'transfer' ? '「不计入消费」' : '「一次性大额」') + '：' + key);
        });
      },
      'save-rules': function () { UI.saveRules().then(function () { UI.toast('规则已保存，全部分析已重算'); }); },
      'reset-rules': function () { UI.resetRules(); },
      'export-rules': function () { UI.exportRules(); },
      'import-rules': function () { U.$('#rulesInput').click(); },
      'folder-rules': function () { UI.loadRulesFromFolder(); },
      'save-budget': function () { App.saveBudget(); },
      'bud-clear': function () { App.budClear(); }
    }[a];
    if (h) { ev.preventDefault(); h(); }
  });

  /* 分类改名（change 委托） */
  document.addEventListener('change', function (ev) {
    const inp = ev.target.closest('[data-cat-rename]');
    if (inp) {
      const lv = Number(inp.dataset.catRename);
      App.renameCat(lv, inp.dataset.l1, inp.dataset.l2, inp.dataset.l3, inp.value);
      return;
    }
    if (ev.target.id === 'scopeSelect') { State.scope = ev.target.value; UI.renderAnalysis(); }
    const rin = ev.target.closest ? ev.target.closest('[data-rule]') : null;
    if (rin) {
      const p = rin.dataset.rule;
      UI.saveRules().then(function () {
        const again = U.$('[data-rule="' + p + '"]');
        if (again) again.focus();
      });
    }
  });

  /* 级联 */
  U.$('#catL1').addEventListener('change', function () { UI.fillCascade(); });
  U.$('#catL2').addEventListener('change', function () { UI.fillCascade(); });

  /* 查找回车 */
  U.$('#searchKw').addEventListener('keydown', function (e) { if (e.key === 'Enter') App.search(); });

  /* 测算器即时计算 */
  ['calcRigid', 'calcMonths', 'calcMonthly', 'sipAmount', 'sipRate', 'sipYears', 'goalRate'].forEach(function (id) {
    U.$('#' + id).addEventListener('input', function () { UI.runCalcs(); });
  });

  /* 文件输入 */
  const ji = document.createElement('input');
  ji.type = 'file'; ji.id = 'jsonInput'; ji.accept = '.json'; ji.style.display = 'none';
  ji.addEventListener('change', async function () {
    const f = ji.files[0]; if (!f) return;
    try {
      const data = JSON.parse(await f.text());
      await Store.importPayload(data, { merge: false });
      UI.toast('JSON 导入成功'); UI.render(); UI.closeDrawer();
    } catch (e) { UI.toast('无效的 JSON 文件'); }
    ji.value = '';
  });
  const xi = document.createElement('input');
  xi.type = 'file'; xi.id = 'excelInput'; xi.accept = '.xlsx,.xls'; xi.style.display = 'none';
  xi.addEventListener('change', function () { const f = xi.files[0]; if (f) App.importExcel(f); xi.value = ''; });
  const ri = document.createElement('input');
  ri.type = 'file'; ri.id = 'rulesInput'; ri.accept = '.json'; ri.style.display = 'none';
  ri.addEventListener('change', function () { const f = ri.files[0]; if (f) UI.importRules(f); ri.value = ''; });
  document.body.appendChild(ji); document.body.appendChild(xi); document.body.appendChild(ri);

  /* 快捷键 */
  document.addEventListener('keydown', function (e) {
    if (e.target.matches('input,select,textarea')) return;
    if (e.key === 'ArrowLeft') App.nav(-1);
    if (e.key === 'ArrowRight') App.nav(1);
    if (e.key === 'Escape') { App.closeDrawer(); App.closeCats(); UI.closeConfirm(); U.$('#quickModal').classList.remove('open'); }
  });

  /* 摸屏滑动切月 */
  let tx = 0;
  document.addEventListener('touchstart', function (e) { tx = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend', function (e) {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 70 && State.pane !== 'analysis') App.nav(dx > 0 ? -1 : 1);
  }, { passive: true });
}

/* ==================================================================
   8. 启动
   ================================================================== */
(async function boot() {
  try {
    await Store.load();
  } catch (e) {
    alert('本地数据库初始化失败：' + (e && e.message ? e.message : e) + '\n请确认浏览器未禁用 IndexedDB。');
    return;
  }
  App.applyTheme(Store.settings.theme || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));

  const d = new Date();
  State.year = d.getFullYear(); State.month = d.getMonth() + 1;
  U.$('#expDate').value = U.todayISO();
  const ym = State.year + '-' + U.pad(State.month);
  U.$('#incMonth').value = ym;
  U.$('#incAmount').value = Store.incomeOf(ym) || '';
  UI.applyRuleDefaults();

  /* 首次使用且有内置数据时提示 */
  if (!Store.expenses.length && window.EMBEDDED) {
    setTimeout(function () {
      UI.confirm('检测到空账本', '是否载入内置参考账本（2026-07-27 ~ 2026-10-07，共 ' + window.EMBEDDED.expenses.length + ' 条）以便立即查看完整分析？<br>也可以稍后从「设置 → 载入内置参考账本」手动载入。', async function () {
        await Store.importPayload({ expenses: window.EMBEDDED.expenses, categories: window.EMBEDDED.categories, monthlyIncomes: window.EMBEDDED.monthlyIncomes }, { merge: true });
        UI.toast('已载入参考账本'); UI.render();
      });
    }, 500);
  }

  bind();
  UI.render();
  U.$('#periodPill').style.display = '';

  window.addEventListener('beforeunload', function () { /* IndexedDB 已即时落库，无需额外处理 */ });
})();

/* 暴露给控制台便于排查 */
window.__APP__ = { Store: Store, Analytics: Analytics, Insights: Insights, UI: UI, State: State };

})();
</script>
</body>
</html>
